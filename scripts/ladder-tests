#!/usr/bin/env node
// Builds the workspace's test binaries once and runs them side by side (PRACTICES, The
// validation ladder). The unit, property, integration, cost, and browser steps each pick tests
// by name out of the same binaries, so the binaries are built in one `cargo test --no-run` and
// run by this script in parallel,
// where `cargo test` runs them one after another: most of them finish in under a second and
// only start-up and the slowest few add up.
//
// usage: scripts/ladder-tests --build LIST
//        scripts/ladder-tests RESULTS [--test NAME] [-- TEST_ARGUMENT...]
//   --build LIST: only build, and write the binaries to the file LIST. scripts/ladder does
//     this once, before the steps that run Rust tests, and passes LIST in
//     LADDER_TEST_LIST, so the ladder builds once; without it (`mise run check:fast FILTER`) a
//     run builds for itself.
//   RESULTS: a file this writes one "package<TAB>test<TAB>result" line to for every test it
//     ran, which is how a step counts its suites (scripts/ladder-lib.sh, ladder_cargo_test).
//   --test NAME: run only the integration test binary NAME of each crate; by default every
//     test binary runs, unit tests included.
//   TEST_ARGUMENT: what `cargo test -- ...` passes each binary (name filters, `--skip`).
// Quiet by design: stdout is the log (each binary's result line in the order they finish, and
// the whole output of one that failed); stderr holds only what a person acts on: the
// diagnostics of a build that failed, and a failed binary's output without its passing tests,
// then the command that reruns each failing test. Exits non-zero when the build or any binary
// fails. Doc tests are not run (the integration step runs them).
import { spawn, spawnSync } from "node:child_process";
import { readFileSync, statSync, writeFileSync } from "node:fs";
import { availableParallelism } from "node:os";
import { basename, dirname } from "node:path";

const argv = process.argv.slice(2);
const usage = "usage: scripts/ladder-tests --build LIST | RESULTS [--test NAME] [-- TEST_ARGUMENT...]";
const buildOnly = argv[0] === "--build";
// The file this writes: the binaries with --build, the results otherwise.
const target = argv[buildOnly ? 1 : 0];
argv.splice(0, buildOnly ? 2 : 1);
let only = null;
if (!buildOnly && argv[0] === "--test") {
  argv.shift();
  only = argv.shift();
}
if (target === undefined || (argv.length > 0 && (buildOnly || argv[0] !== "--"))) {
  console.error(usage);
  process.exit(2);
}
const testArguments = argv.slice(1);

// A package id is "path+file:///<dir>#<name>@<version>", or "...<dir>#<version>" when the
// name is the directory's.
function nameOf(id) {
  const [location, fragment] = id.split("#");
  return fragment.includes("@") ? fragment.split("@")[0] : basename(location);
}

// Cargo features resolve per invocation, so the build is the whole workspace with every
// feature, as every other cargo command of the ladder is. Every test binary, with the name of
// its integration test when it is one.
function build() {
  const built = spawnSync(
    "cargo",
    ["test", "--locked", "--workspace", "--all-features", "--tests", "--no-run", "-q", "--message-format=json-render-diagnostics"],
    { encoding: "utf8", maxBuffer: 1 << 30, stdio: ["ignore", "pipe", "pipe"] },
  );
  // Quiet cargo prints only diagnostics, to the log, and to the person when the build failed.
  process.stdout.write(built.stderr);
  const binaries = [];
  for (const line of built.stdout.split("\n")) {
    if (!line.startsWith('{"reason":')) continue;
    const message = JSON.parse(line);
    if (message.reason !== "compiler-artifact" || !message.profile.test || message.executable === null) continue;
    const integration = message.target.kind.includes("test") ? message.target.name : null;
    binaries.push({
      executable: message.executable,
      directory: dirname(message.manifest_path),
      package: nameOf(message.package_id),
      integration,
      label: `${nameOf(message.package_id)} ${integration ?? "unit tests"} (${basename(message.target.src_path)})`,
      size: statSync(message.executable).size,
    });
  }
  if (built.status !== 0) {
    process.stderr.write(built.stderr);
    console.error("ladder-tests: the test binaries did not build");
    process.exit(1);
  }
  return binaries;
}

/** The binaries to run: those `--build` listed for this ladder run, or a build of its own. */
function binariesToRun() {
  const list = process.env["LADDER_TEST_LIST"];
  const binaries = list === undefined || list === "" ? build() : JSON.parse(readFileSync(list, "utf8"));
  return only === null ? binaries : binaries.filter((binary) => binary.integration === only);
}

function run(binary) {
  return new Promise((resolve) => {
    // Cargo runs a test binary from its package's directory.
    // Each binary gets its share of the cores, so the parallel binaries together use about one thread
    // per core instead of each starting one per core; the biggest, which holds most of the tests
    // (the library crates' one integration binary), gets half of them.
    const count = binary === binaries[0] ? Math.max(1, Math.floor(availableParallelism() / 2)) : threads;
    const env = { RUST_TEST_THREADS: String(count), ...process.env };
    const child = spawn(binary.executable, testArguments, { cwd: binary.directory, env, stdio: ["ignore", "pipe", "pipe"] });
    let output = "";
    child.stdout.on("data", (chunk) => (output += chunk));
    child.stderr.on("data", (chunk) => (output += chunk));
    child.on("error", (error) => resolve({ binary, output: `${error.message}\n`, status: 1 }));
    child.on("close", (status) => resolve({ binary, output, status: status ?? 1 }));
  });
}

if (buildOnly) {
  writeFileSync(target, JSON.stringify(build()));
  process.exit(0);
}
const binaries = binariesToRun();
// The biggest binaries hold the slowest tests, so they start first.
binaries.sort((left, right) => right.size - left.size);
const limit = Math.max(2, Math.floor(availableParallelism() / 2));
const threads = Math.max(1, Math.floor(availableParallelism() / limit));
const lines = [];
let failed = 0;
let next = 0;
async function worker() {
  while (next < binaries.length) {
    const { binary, output, status } = await run(binaries[next++]);
    const summary = output.split("\n").find((line) => line.startsWith("test result:")) ?? "no test result";
    console.log(`     Ran ${binary.label}: ${summary}`);
    if (status !== 0) {
      failed++;
      console.log(output);
      // The tests that passed are the log's, as are the names a count reads.
      console.error(output.split("\n").filter((line) => !/^test .* \.\.\. ok$/.test(line)).join("\n"));
      for (const [, name] of output.matchAll(/^test (.+) \.\.\. FAILED$/gm)) console.error(`rerun: mise run check:fast ${name}`);
    }
    for (const line of output.split("\n")) {
      const test = /^test (.+) \.\.\. (\S+)/.exec(line);
      if (!test) continue;
      // The library crates' integration tests are one binary (crates/tests) with a module per
      // crate; each test counts for its crate, under the name it has there.
      const [crate, ...path] = test[1].split("::");
      const merged = binary.package === "cairn-tests";
      lines.push(`${merged ? `cairn-${crate.replaceAll("_", "-")}` : binary.package}\t${merged ? path.join("::") : test[1]}\t${test[2]}`);
    }
  }
}
await Promise.all(Array.from({ length: Math.min(limit, binaries.length) }, worker));
writeFileSync(target, lines.map((line) => `${line}\n`).join(""));
if (binaries.length === 0) {
  console.error("ladder-tests: no test binary matched");
  process.exit(1);
}
process.exit(failed === 0 ? 0 : 1);
