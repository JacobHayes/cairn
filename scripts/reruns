#!/usr/bin/env node
// The commands that rerun the tests that failed in a Vitest or Playwright run (the files, for
// Vitest, and the titles for Playwright), one line each,
// read from the JSON report the run wrote beside its terse terminal reporter (whose output
// has the failures themselves). Prints nothing when none failed.
//
// usage: scripts/reruns vitest|playwright REPORT
import { readFileSync } from "node:fs";
import { relative } from "node:path";

const [kind, file] = process.argv.slice(2);
if ((kind !== "vitest" && kind !== "playwright") || file === undefined) {
  console.error("usage: scripts/reruns vitest|playwright REPORT");
  process.exit(2);
}
const report = JSON.parse(readFileSync(file, "utf8"));

const titles = [];
if (kind === "vitest") {
  // The file, not the title: a parameterized test's title is not in the source.
  for (const suite of report.testResults) {
    if (suite.status === "failed") titles.push(relative(process.cwd(), suite.name));
  }
} else {
  const walk = (suite) => {
    for (const spec of suite.specs ?? []) {
      if (spec.tests.some((test) => test.status !== "expected" && test.status !== "skipped")) titles.push(spec.title);
    }
    (suite.suites ?? []).forEach(walk);
  };
  report.suites.forEach(walk);
}
for (const title of new Set(titles)) console.log(`rerun: mise run check:fast '${title.replaceAll("'", "'\\''")}'`);
