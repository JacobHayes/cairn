#!/usr/bin/env bash
# The two servers the app's browser tests run against (web/app/playwright.config.ts), started
# side by side where Playwright would start its webServer entries one after another: `cairn
# demo` (the server host: the binary over the fixtures in memory, serving its web
# build and the API on one port) and the static demo site on the in-browser host (the app built
# with no server, `mise run build:web demo`, served by `vite preview`: the shipped bundle, not
# the dev server's unbundled modules and development React). Each one's wait (the cargo no-op,
# the demo build) overlaps the other's. Prints READY once both
# answer, which is what Playwright waits for, and exits non-zero when either stops. The ports
# are the config's, passed in the environment: CAIRN_SERVER_PORT and CAIRN_DEMO_PORT. With
# CAIRN_E2E_BINARY=0 the binary is left out (`mise run check:fast` does so for a spec with no
# server-host test, which then needs no web build).
#
# usage: scripts/e2e-servers
set -euo pipefail
cd "$(dirname "$0")/.."
# The servers' logs and this script's messages go to a file: a run's output would otherwise be
# a JSON line per request.
mkdir -p dist/ladder
exec 2>dist/ladder/servers.log
: "${CAIRN_SERVER_PORT:?}" "${CAIRN_DEMO_PORT:?}"
vite=$PWD/node_modules/vite/bin/vite.js
# The ladder's (scripts/ladder-lib.sh), or the same folder when Playwright runs on its own.
export CAIRN_WEB_DIR=${CAIRN_WEB_DIR:-$PWD/web/app/dist/build}

pids=()
urls=("http://127.0.0.1:$CAIRN_DEMO_PORT/")
if [ "${CAIRN_E2E_BINARY:-1}" != 0 ]; then
  # The binary the ladder's one build of the test binaries links (scripts/ladder-tests), by the
  # same command, so in the ladder it is a no-op: a build of `-p cairn` resolves features
  # differently, compiling the crates again and replacing the binary the tests run.
  (cargo test --locked --quiet --workspace --all-features --tests --no-run &&
    exec "${CARGO_TARGET_DIR:-target}/debug/cairn" demo --listen "127.0.0.1:$CAIRN_SERVER_PORT") >/dev/null &
  pids+=($!)
  urls+=("http://127.0.0.1:$CAIRN_SERVER_PORT/api/capabilities")
fi
# The demo site is built once, here, for every caller (the ladder's browser step, `mise run
# check:fast`, a bare `playwright test`, `mise run proof`); its module build was made before. The
# preview takes the port on its command line: vite.config.ts sets one under `server` only. It
# must not see a CAIRN_SERVER from the caller.
mise-tasks/build/web demo >/dev/null
(cd web/app && exec env -u CAIRN_SERVER node "$vite" preview --config vite.config.ts --mode demo --outDir dist/demo --host 127.0.0.1 --port "$CAIRN_DEMO_PORT" --strictPort >/dev/null) &
pids+=($!)

# Whether every server is still running. Only what macOS's Bash 3.2 has (no `wait -n`), since
# a targeted Playwright run may find that bash first.
all_running() {
  local pid
  for pid in "${pids[@]}"; do
    kill -0 "$pid" 2>/dev/null || return 1
  done
}

for url in "${urls[@]}"; do
  until curl --silent --fail --output /dev/null "$url"; do
    all_running || { echo "e2e-servers: a server stopped before $url answered" >&2; exit 1; }
    sleep 0.1
  done
done
echo READY
while all_running; do
  sleep 1
done
echo "e2e-servers: a server stopped" >&2
exit 1
