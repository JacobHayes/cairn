#!/usr/bin/env bash
# Runs the rungs of the validation ladder that exist, in order, and stops at the first
# failure (PRACTICES, The validation ladder; Growing the ladder).
#
# usage: scripts/ladder [--changed] [HIGHEST_RUNG]
#
# A rung exists when its task file mise-tasks/check/<N> exists; adding the file adds the
# rung to `mise run check` and makes `mise run check:<N>` run it alone. With HIGHEST_RUNG
# (`check:fast` passes 3), rungs above it are left out. Each rung reports its suites
# through scripts/ladder-lib.sh; the summary at the end repeats those lines.
#
# With --changed (`check:fast`), the Rust rungs (2 and 3) are left out when the current change
# touches no Rust input (scripts/changed), and a line says so. Rung 1 always runs whole: a Rust
# change can break the web app through the API and the generated types. Without it, as in
# `mise run check` and CI, nothing is skipped.
set -euo pipefail
cd "$(dirname "$0")/.."

skipped=()
if [ "${1:-}" = --changed ]; then
  shift
  read -r changed_rust _ changed_count < <(scripts/changed)
  if [ "$changed_count" = - ]; then
    echo "ladder: --changed: no diff available: no rung skipped"
  elif [ "$changed_rust" = 1 ]; then
    echo "ladder: --changed: ${changed_count} files changed, Rust inputs among them: no rung skipped"
  else
    skipped=(2 3)
    echo "ladder: --changed: ${changed_count} files changed, none a Rust input: skipping rungs 2 and 3 (the Rust tests)"
  fi
fi

highest=${1:-}
rungs=()
for path in mise-tasks/check/*; do
  rung=${path##*/}
  [[ $rung =~ ^[0-9]+$ ]] || continue
  [ -z "$highest" ] || [ "$rung" -le "$highest" ] || continue
  [[ " ${skipped[*]} " != *" $rung "* ]] || continue
  rungs+=("$rung")
done
if [ ${#rungs[@]} -eq 0 ]; then
  echo "ladder: FAILED: no rungs exist${highest:+ at or below $highest}" >&2
  exit 1
fi
mapfile -t rungs < <(printf '%s\n' "${rungs[@]}" | sort -n)
echo "ladder: rungs that exist${highest:+ at or below $highest}: ${rungs[*]}"

# Pass each rung's output through to the terminal on descriptor 3 (inherited, never
# reopened, so a redirect to a file keeps its order) while keeping its summary lines.
exec 3>&1
summary=()
# Rungs 2 to 4 pick their Rust tests by name out of the same test binaries, which are built
# once, before the first of them (scripts/ladder-tests). Rung 6 builds its own after the web
# build changes what the binary embeds.
test_list=dist/ladder/test-binaries.json
tests_built=
for rung in "${rungs[@]}"; do
  echo "ladder: rung $rung: starting"
  start=$SECONDS
  list=
  if [ "$rung" -ge 2 ] && [ "$rung" -le 4 ]; then
    if [ -z "$tests_built" ]; then
      mkdir -p dist/ladder
      scripts/ladder-tests --build "$test_list" || { echo "ladder: rung $rung: FAILED: the test binaries did not build" >&2; exit 1; }
      tests_built=yes
    fi
    list=$test_list
  fi
  # pipefail (set above) makes the pipeline's status the rung's.
  if lines=$(LADDER_TEST_LIST=$list "mise-tasks/check/$rung" 2>&1 3>&- | while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >&3
    case $line in "ladder: rung $rung: "*) printf '%s\n' "$line" ;; esac
  done); then
    status=passed
  else
    status=FAILED
  fi
  summary+=("$lines")
  summary+=("ladder: rung $rung: $status in $((SECONDS - start))s")
  if [ "$status" = FAILED ]; then
    break
  fi
done

echo
echo "ladder: summary"
printf '%s\n' "${summary[@]}" | grep -v -e ': starting$' -e ': passed$' || true
if [ "$status" = FAILED ]; then
  echo "ladder: check FAILED at rung $rung; later rungs did not run"
  exit 1
fi
echo "ladder: check passed: rungs ${rungs[*]}"
