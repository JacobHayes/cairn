#!/usr/bin/env bash
# Runs the validation ladder (PRACTICES, The validation ladder): `mise run check` (the whole
# thing) or `mise run check:fast` (the part a change can affect, fewer steps).
#
# usage: scripts/ladder [--fast | --part NAME | --parts]
#
# The steps are the files of scripts/steps/. The fail-early ones run first, one at a time, in
# order: lint (format, lint, typecheck), then the unit tests (unit: Rust; web-unit: Vitest),
# then, in the full check, generated (regenerates files the others read, so it runs alone)
# and embed (the binary's build with the web build embedded).
# Only then do the slow steps that are independent of one another run side by side: property,
# integration, cost, browser, and, in the full check, advisories (RustSec, over the network).
# A step prints one line when it passes and what a person acts on when it fails, and writes
# everything else to dist/ladder/<step>.log. The side-by-side
# steps' lines are printed in order once all have finished.
#
# With --fast, steps are left out when the current change touches none of their inputs
# (scripts/changed): the Rust steps (unit, property) and the Rust half of lint (rustfmt,
# clippy, also over the testbeds, the wasm32 build, patina labels) when no Rust input changed, and the web steps
# (web-unit, browser) when neither side changed (the web unit tests compare the browser host's
# module with the server's answers). The browser step runs only against the in-browser host,
# with no web build embedded and no binary built or tested, unless the change touches the
# server side of the web app. The full check and CI skip nothing. The integration step runs when the
# change touches the crates its tests build, with their dependencies, derived from the manifests
# (scripts/changed; decisions/2026-10-21-check-fast-runs-the-integration-tests-their-inputs-touch.md),
# and so does the cost step, whose tests are modules of that same test binary
# (decisions/2026-10-22-check-fast-runs-the-cost-tests-with-the-integration-tests.md);
# advisories, which needs the network, is left out of --fast.
#
# CI runs the full check in parts, one runner each and side by side: --part NAME runs the steps
# of that part, in the order above, building only what they need. A part is the steps that
# share one build (lint: lint and advisories, which build nothing; rust: the Rust test steps;
# web: the web build and what reads it; browser: the binary and Playwright). --parts prints them as a JSON array, which is the
# workflow's matrix, so a part added here runs in CI with no workflow edit; every invocation
# fails when a step of the full check belongs to no part, or to two.
#
# The mise tasks run it under the machine-wide lock (scripts/locked): one run at a time.
set -euo pipefail
cd "$(dirname "$0")/.."

# The steps of the full check in the order they run (one at a time, then side by side), and the
# part each runs in on CI. Plain arrays and "step:part" entries: macOS ships Bash 3.2.
all_first=(lint unit web-unit generated embed)
all_side=(property integration cost browser advisories)
step_parts=(lint:lint advisories:lint unit:rust property:rust integration:rust cost:rust web-unit:web generated:web embed:web browser:browser)
parts=(lint rust web browser)

usage() { echo "usage: scripts/ladder [--fast | --part NAME | --parts]" >&2; exit 2; }
partition_fail() { echo "ladder: the parts are wrong: $1" >&2; exit 2; }

# Every step of the full check is in exactly one part, every part has a step, and nothing else
# is listed, so no step can drop out of CI.
partition_check() {
  local step part entry count other
  for step in "${all_first[@]}" "${all_side[@]}"; do
    count=0
    for other in "${all_first[@]}" "${all_side[@]}"; do [ "$other" != "$step" ] || count=$((count + 1)); done
    [ "$count" -eq 1 ] || partition_fail "step $step is listed $count times in the full check"
    count=0
    for entry in "${step_parts[@]}"; do [ "${entry%%:*}" != "$step" ] || count=$((count + 1)); done
    [ "$count" -eq 1 ] || partition_fail "step $step is in $count parts, not one"
  done
  for entry in "${step_parts[@]}"; do
    step=${entry%%:*}
    part=${entry#*:}
    [[ " ${all_first[*]} ${all_side[*]} " == *" $step "* ]] || partition_fail "$entry names a step that is not in the full check"
    [[ " ${parts[*]} " == *" $part "* ]] || partition_fail "$entry names a part that is not listed"
  done
  for entry in scripts/steps/*; do
    step=${entry##*/}
    [[ " ${all_first[*]} ${all_side[*]} " == *" $step "* ]] || partition_fail "scripts/steps/$step is no step of the full check"
  done
  for part in "${parts[@]}"; do
    count=0
    for other in "${parts[@]}"; do [ "$other" != "$part" ] || count=$((count + 1)); done
    [ "$count" -eq 1 ] || partition_fail "part $part is listed $count times"
    [[ " ${step_parts[*]} " == *":$part "* ]] || partition_fail "part $part has no step"
  done
}
partition_check

# The part of a step of the full check.
part_of() {
  local entry
  for entry in "${step_parts[@]}"; do
    if [ "${entry%%:*}" = "$1" ]; then echo "${entry#*:}"; return 0; fi
  done
}

fast=
part=
case ${1:-} in
  --fast) fast=1; shift ;;
  --part)
    [ $# -ge 2 ] || usage
    part=$2
    [[ " ${parts[*]} " == *" $part "* ]] || { echo "ladder: no part $part; the parts are: ${parts[*]}" >&2; exit 2; }
    shift 2
    ;;
  --parts)
    [ $# -eq 1 ] || usage
    printf '['
    sep=
    for name in "${parts[@]}"; do printf '%s"%s"' "$sep" "$name"; sep=,; done
    printf ']\n'
    exit 0
    ;;
esac
[ $# -eq 0 ] || usage

rust=1
web=1
server=1
integration=1
if [ -n "$fast" ]; then
  read -r changed_rust changed_web changed_server changed_integration changed_count < <(scripts/changed)
  if [ "$changed_count" != - ]; then
    rust=$changed_rust
    web=$changed_web
    server=$changed_server
    integration=$changed_integration
    echo "ladder: $changed_count files changed (Rust inputs: $rust, web inputs: $web, server side: $server, integration tests: $integration); leaving out the steps they do not touch"
  fi
fi
# The steps read these: lint leaves out the Rust half, browser the binary and its web build.
export LADDER_RUST=$rust LADDER_SERVER=$server

# The steps that run one at a time, then the ones that run side by side.
first=()
side=()
if [ -n "$part" ]; then
  for step in "${all_first[@]}"; do [ "$(part_of "$step")" != "$part" ] || first+=("$step"); done
  for step in "${all_side[@]}"; do [ "$(part_of "$step")" != "$part" ] || side+=("$step"); done
elif [ -z "$fast" ]; then
  first=("${all_first[@]}")
  side=("${all_side[@]}")
else
  first=(lint)
  if [ "$rust" = 1 ]; then first+=(unit); fi
  if [ "$rust" = 1 ] || [ "$web" = 1 ]; then first+=(web-unit); fi
  if [ "$rust" = 1 ]; then side+=(property); fi
  if [ "$integration" = 1 ]; then side+=(integration cost); fi
  if [ "$web" = 1 ]; then side+=(browser); fi
fi

mkdir -p dist/ladder
started=$SECONDS
failed=

# What CI's Rust dependency cache reported (LADDER_CACHE_HIT: rust-cache's cache-hit output,
# "true" only for an exact key match), worded as that and no more: an exact hit says the
# dependencies were restored, not that the restored build was warm, and no exact hit may still
# have restored a near one. Empty on a developer's machine.
cache_note() {
  case ${LADDER_CACHE_HIT:-} in
    true) echo "exact dependency-cache hit" ;;
    false) echo "no exact dependency-cache hit" ;;
  esac
}

# Before the first step after lint, which may fix files, and before the tests: the web build
# that the binary serves and the embed step reads (the browser step runs it, and so does
# embed, which in a part of its own gets no build from a step beside it), then the test
# binaries every Rust test step picks from (scripts/ladder-tests), built once. They read the web
# build at run time (CAIRN_WEB_DIR), so it is no input of them. The browser step needs the web
# build and the tests only when it runs the binary (server is 1: always in the full check).
# A part without those steps (lint) builds nothing.
prepare() {
  local step log=dist/ladder/build.log needs_tests= needs_web= built= build_started=$SECONDS
  : >"$log"
  for step in ${first[@]+"${first[@]}"} ${side[@]+"${side[@]}"}; do
    case $step in
      unit | property | integration | cost) needs_tests=1 ;;
      embed) needs_web=1 ;;
      browser) [ "$server" != 1 ] || { needs_tests=1; needs_web=1; } ;;
    esac
  done
  if [ -n "$needs_web" ]; then
    mise run build:web >>"$log" 2>&1 || { tail -n 30 "$log"; echo "build: FAILED in $((SECONDS - started))s: the web build; log: $log"; exit 1; }
    built="the web build"
  fi
  if [ -n "$needs_tests" ]; then
    # stdout is the log; a build error shows on stderr.
    scripts/ladder-tests --build dist/ladder/test-binaries.json >>"$log" || {
      echo "build: FAILED in $((SECONDS - started))s: the test binaries did not build; log: $log"
      exit 1
    }
    export LADDER_TEST_LIST=dist/ladder/test-binaries.json
    built="${built:+$built and }the test binaries"
  fi
  [ -z "$built" ] || {
    echo "build: passed, $built, $((SECONDS - build_started))s${cache_noted:+ ($cache_noted)}"
    cache_noted=
  }
}

prepared=
cache_noted=$(cache_note)
for step in ${first[@]+"${first[@]}"}; do
  if [ "$step" != lint ] && [ -z "$prepared" ]; then
    prepare
    prepared=1
  fi
  scripts/steps/"$step" || {
    echo "ladder: FAILED at $step after $((SECONDS - started))s; later steps did not run; log: dist/ladder/$step.log"
    exit 1
  }
done

if [ ${#side[@]} -gt 0 ]; then
  [ -n "$prepared" ] || prepare
  pids=()
  for step in "${side[@]}"; do
    scripts/steps/"$step" >dist/ladder/"$step".out &
    pids+=($!)
  done
  for index in "${!side[@]}"; do
    step=${side[$index]}
    wait "${pids[$index]}" || failed="$failed $step"
    cat dist/ladder/"$step".out
  done
fi

if [ -n "$failed" ]; then
  echo "ladder: FAILED at${failed} after $((SECONDS - started))s; logs: dist/ladder/<step>.log"
  exit 1
fi
ran=(${first[@]+"${first[@]}"} ${side[@]+"${side[@]}"})
# The build line carries the cache note when there was one; a part that built nothing (lint)
# says it here, since its clippy builds ran against the same cache.
echo "ladder: passed${part:+ (part $part)}, ${ran[*]}, $((SECONDS - started))s${cache_noted:+ ($cache_noted)}; logs: dist/ladder/"
