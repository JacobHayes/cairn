#!/usr/bin/env bash
# Runs the rungs of the validation ladder that exist, in order, and stops at the first
# failure (PRACTICES, The validation ladder; Growing the ladder).
#
# usage: scripts/ladder [HIGHEST_RUNG]
#
# A rung exists when its task file mise-tasks/check/<N> exists; adding the file adds the
# rung to `mise run check` and makes `mise run check:<N>` run it alone. With HIGHEST_RUNG
# (`check:fast` passes 3), rungs above it are left out. Each rung reports its suites
# through scripts/ladder-lib.sh; the summary at the end repeats those lines.
set -euo pipefail
cd "$(dirname "$0")/.."

highest=${1:-}
rungs=()
for path in mise-tasks/check/*; do
  rung=${path##*/}
  [[ $rung =~ ^[0-9]+$ ]] || continue
  [ -z "$highest" ] || [ "$rung" -le "$highest" ] || continue
  rungs+=("$rung")
done
if [ ${#rungs[@]} -eq 0 ]; then
  echo "ladder: FAILED: no rungs exist${highest:+ at or below $highest}" >&2
  exit 1
fi
mapfile -t rungs < <(printf '%s\n' "${rungs[@]}" | sort -n)
echo "ladder: rungs that exist${highest:+ at or below $highest}: ${rungs[*]}"

# Pass each rung's output through to the terminal on descriptor 3 (inherited, never
# reopened, so a redirect to a file keeps its order) while keeping its summary lines.
exec 3>&1
summary=()
for rung in "${rungs[@]}"; do
  echo "ladder: rung $rung: starting"
  start=$SECONDS
  # pipefail (set above) makes the pipeline's status the rung's.
  if lines=$("mise-tasks/check/$rung" 2>&1 3>&- | while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >&3
    case $line in "ladder: rung $rung: "*) printf '%s\n' "$line" ;; esac
  done); then
    status=passed
  else
    status=FAILED
  fi
  summary+=("$lines")
  summary+=("ladder: rung $rung: $status in $((SECONDS - start))s")
  if [ "$status" = FAILED ]; then
    break
  fi
done

echo
echo "ladder: summary"
printf '%s\n' "${summary[@]}" | grep -v -e ': starting$' -e ': passed$' || true
if [ "$status" = FAILED ]; then
  echo "ladder: check FAILED at rung $rung; later rungs did not run"
  exit 1
fi
echo "ladder: check passed: rungs ${rungs[*]}"
