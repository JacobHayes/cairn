#!/usr/bin/env bash
# Runs the rungs of the validation ladder that exist, in order, and stops at the first
# failure (PRACTICES, The validation ladder; Growing the ladder).
#
# usage: scripts/ladder [--changed] [HIGHEST_RUNG]
#
# A rung exists when its task file mise-tasks/check/<N> exists; adding the file adds the
# rung to `mise run check` and makes `mise run check:<N>` run it alone. With HIGHEST_RUNG
# (`check:fast` passes 3), rungs above it are left out.
#
# Quiet: the whole run's output goes to dist/ladder/last.log, and the terminal gets one line
# per rung (scripts/ladder-lib.sh), what a failure needs (the errors, the failing tests and
# lines, how to rerun them), and one last line with the log's path.
#
# With --changed (`check:fast`), the Rust rungs (2 and 3) are left out when the current change
# touches no Rust input (scripts/changed), and a line says so. Rung 1 always runs whole: a Rust
# change can break the web app through the API and the generated types. Without it, as in
# `mise run check` and CI, nothing is skipped.
set -euo pipefail
cd "$(dirname "$0")/.."

export LADDER_LOG=dist/ladder/last.log
mkdir -p dist/ladder
: >"$LADDER_LOG"

skipped=()
if [ "${1:-}" = --changed ]; then
  shift
  read -r changed_rust _ changed_count < <(scripts/changed)
  if [ "$changed_count" != - ] && [ "$changed_rust" != 1 ]; then
    skipped=(2 3)
    echo "ladder: ${changed_count} files changed, none a Rust input: skipping rungs 2 and 3 (the Rust tests)"
  fi
fi

highest=${1:-}
rungs=()
for path in mise-tasks/check/*; do
  rung=${path##*/}
  [[ $rung =~ ^[0-9]+$ ]] || continue
  [ -z "$highest" ] || [ "$rung" -le "$highest" ] || continue
  [[ " ${skipped[*]} " != *" $rung "* ]] || continue
  rungs+=("$rung")
done
if [ ${#rungs[@]} -eq 0 ]; then
  echo "ladder: FAILED: no rungs exist${highest:+ at or below $highest}" >&2
  exit 1
fi
mapfile -t rungs < <(printf '%s\n' "${rungs[@]}" | sort -n)

# Rungs 2, 3, 4, and 7 pick their Rust tests by name out of the same test binaries, which are
# built once, before the first of them (scripts/ladder-tests). Rung 6 builds its own after the
# web build changes what the binary embeds.
test_list=dist/ladder/test-binaries.json
tests_built=
started=$SECONDS
failed=
for rung in "${rungs[@]}"; do
  LADDER_STARTED=$(date +%s)
  export LADDER_STARTED
  list=
  case $rung in 2 | 3 | 4 | 7)
    if [ -z "$tests_built" ]; then
      # stdout is the log; a build error shows on stderr.
      scripts/ladder-tests --build "$test_list" >>"$LADDER_LOG" || {
        echo "rung $rung: FAILED in $((SECONDS - started))s: the test binaries did not build"
        failed=$rung
        break
      }
      tests_built=yes
    fi
    list=$test_list
    ;;
  esac
  LADDER_TEST_LIST=$list "mise-tasks/check/$rung" || {
    failed=$rung
    break
  }
done

if [ -n "$failed" ]; then
  echo "ladder: FAILED at rung $failed after $((SECONDS - started))s; later rungs did not run; rerun: mise run check:$failed; log: $LADDER_LOG"
  exit 1
fi
echo "ladder: passed, rungs ${rungs[*]}, $((SECONDS - started))s; log: $LADDER_LOG"
