#!/usr/bin/env bash
# The server's answers the browser host's agreement tests (web/wasm) compare with: the
# cairn-wasm-cases binary walks the fixtures through the service natively and writes them to
# web/wasm/dist/cases. Its output is a function of the crates it links (found from the manifests) and the fixtures, so it
# is kept with a hash of those inputs (cases.hash, written only after a complete run), and a
# run whose inputs are unchanged, as in most changes to the app alone, reuses it. Any file
# under the crates, the fixtures, or the workspace's manifests, lock file, and toolchain pin
# changes the hash. It runs in the optimized test profile.
#
# usage: scripts/agreement-cases
set -euo pipefail
cd "$(dirname "$0")/.."
# The crates the wasm crate depends on, from the manifests (their closure), and what they read.
mapfile -t crates < <(cargo metadata --no-deps --offline --format-version 1 | node -e '
  const metadata = JSON.parse(require("fs").readFileSync(0, "utf8"));
  const byName = new Map(metadata.packages.map((each) => [each.name, each]));
  const seen = new Set();
  const pending = ["cairn-wasm"];
  while (pending.length > 0) {
    const name = pending.pop();
    if (seen.has(name) || !byName.has(name)) continue;
    seen.add(name);
    pending.push(...byName.get(name).dependencies.map((each) => each.name));
  }
  const root = process.cwd() + "/";
  for (const name of seen) console.log(byName.get(name).manifest_path.replace(root, "").replace(/\/Cargo\.toml$/, ""));')
inputs=("${crates[@]}" fixtures Cargo.toml Cargo.lock mise.toml)
hash=$(find "${inputs[@]}" -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)
if [ "$(cat web/wasm/dist/cases.hash 2>/dev/null || true)" = "$hash" ] && [ -n "$(ls web/wasm/dist/cases 2>/dev/null)" ]; then
  echo "the server's agreement cases: inputs unchanged, reusing web/wasm/dist/cases"
  exit 0
fi
rm -f web/wasm/dist/cases.hash
scripts/timed build cargo build --locked --quiet --profile test -p cairn-wasm --features server --bin cairn-wasm-cases
scripts/timed tests cargo run --locked --quiet --profile test -p cairn-wasm --features server --bin cairn-wasm-cases -- web/wasm/dist/cases
printf '%s\n' "$hash" >web/wasm/dist/cases.hash
