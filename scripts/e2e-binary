#!/usr/bin/env bash
# The real binary for the app's browser tests (web/app/playwright.config.ts, project
# `binary`): a fresh directory holding a configuration (loopback at the given port, UTC, the
# dev provider signing every request in, as the fixture server does) and a database seeded
# with every fixture, then `cairn serve` over them in the foreground.
#
# usage: scripts/e2e-binary PORT
set -euo pipefail
cd "$(dirname "$0")/.."
port=${1:?usage: scripts/e2e-binary PORT}
directory=web/app/dist/binary-$port
rm -rf "$directory"
mkdir -p "$directory"
cat >"$directory/cairn.toml" <<TOML
database = "cairn.db"
listen = "127.0.0.1:$port"
public_url = "http://127.0.0.1:$port/"
timezone = "UTC"

[[auth]]
kind = "dev"
name = "dev"
user = "dev"
TOML
scripts/built examples/seed_fixtures "$directory/cairn.db"
# Only the file configures it: none of the caller's CAIRN_ variables (overrides or secrets)
# reaches the binary.
while IFS= read -r variable; do
  unset "$variable"
done < <(compgen -e | grep '^CAIRN_' || true)
exec scripts/built cairn serve --config "$directory/cairn.toml"
