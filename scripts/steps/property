#!/usr/bin/env bash
# Step property: property tests (PROPTEST_CASES cases each, 64 by default; CI runs 256).
# PRACTICES, The validation ladder; Property tests. Property tests are the tests in
# `tests/integration/property_*.rs`, each inside `mod property`, run through
# patina-dst-proptest from a fixed seed. They are modules of their crate's one integration
# test binary, selected by module path. One suite per property test file, counted from the
# test names (`<file>::property::<test>`). The cost tests are the cost step's. The case count is
# bounded locally and larger in CI: 256 on push and 4096 nightly
# (decisions/2026-10-08-property-tests-run-64-cases-locally-and-256-in-ci.md).
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_STEP=property
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

ladder_require_tool cargo cargo --version
ladder_require_tool node node --version
# The counts below are read from cargo's output, which must not carry color codes (CI sets
# CARGO_TERM_COLOR=always).
export CARGO_TERM_COLOR=never
export PROPTEST_CASES=${PROPTEST_CASES:-64}
# Zero cases would pass every property while generating nothing.
[[ $PROPTEST_CASES =~ ^[1-9][0-9]*$ ]] || ladder_fail "PROPTEST_CASES must be a positive count, not '$PROPTEST_CASES'"
ladder_say "PROPTEST_CASES=$PROPTEST_CASES"

# The test binaries built once up front, run by name (ladder_cargo_test), one suite per file.
ladder_cargo_test --test integration -- property:: || ladder_fail "cargo test reported failures"
ladder_file_suites property

ladder_step_end
