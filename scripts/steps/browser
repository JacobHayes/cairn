#!/usr/bin/env bash
# Step browser: end-to-end tests of the app against `cairn demo` (Playwright in Chromium, one
# suite per web package with a playwright.config.ts).
# PRACTICES, The validation ladder. The binary serves the app's build
# (web/app/dist/build/): its own tests that start it (`mod binary` in
# crates/cairn/tests/integration/binary.rs, so `binary::binary::`) are a suite here, and each of
# the app's tests starts a `cairn demo` of its own, the same binary over the fixtures in memory
# (web/app/e2e/test.ts). A suite that runs no test, or any test that fails or is skipped, fails
# the step. The browsers are Playwright's own, pinned with @playwright/test:
# `npx playwright install chromium` once per machine.
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_STEP=browser
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

ladder_require_tool cargo cargo --version
ladder_require_tool node node --version
ladder_require_tool playwright node_modules/.bin/playwright --version
export CARGO_TERM_COLOR=never

# The module and the web build the binary serves were built before this step (scripts/ladder),
# and so were the test binaries, whose build links the binary too: the binary's tests run it,
# and the tests' demos start it (scripts/demo-binary builds it once, a no-op here).
# The walks (every screen state's structural checks, and the same over the breakpoints) are
# projects of the same run, so one report covers them (`mise run screenshots`, `mise run sweep`).
projects=(--project=chromium --project=screenshots --project=sweep)
ladder_cargo_test --test integration -- "${ladder_binary_modules[@]}" || ladder_fail "the binary's tests failed"
ladder_suite "binary" "$(ladder_tests_matching cairn '^binary::binary::')" tests

# One Playwright run of `config` in `package`, its counts checked: a run that passes nothing, or
# any test that fails or is skipped, fails the step. The rest of the arguments select projects.
run_playwright() {
  local package=$1 config=$2 label=$3
  shift 3
  local report="$PWD/$package/dist/playwright.json" status=0
  rm -f "$report"
  # The dot reporter prints a dot per test and the failures; the JSON report is for the
  # counts. The servers Playwright starts must not hold the terminal (descriptor 3) open.
  output=$(cd "$package" && PLAYWRIGHT_JSON_OUTPUT_NAME="$report" \
    "$ladder_timed" tests "$OLDPWD/node_modules/.bin/playwright" test -c "$config" --reporter=dot,json "$@" 3>&- 2>&1) || status=$?
  printf '%s\n' "$output"
  [ -f "$report" ] || { ladder_show "$output"; ladder_fail "Playwright wrote no report for $package"; }
  # shellcheck disable=SC2016 # the backticks are a JavaScript template literal
  read -r passed failed skipped < <(node -e '
    const stats = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).stats;
    console.log(`${stats.expected} ${stats.unexpected + stats.flaky} ${stats.skipped}`);' "$report")
  [ "$status" -eq 0 ] && [ "$failed" -eq 0 ] || {
    ladder_show "$output"
    node scripts/reruns playwright "$report" | ladder_show
    ladder_fail "$failed $label failed in $package"
  }
  [ "$skipped" -eq 0 ] || ladder_fail "$skipped $label were skipped in $package"
  ladder_suite "$label: $package" "$passed" tests
}

for config in web/*/playwright.config.ts; do
  run_playwright "$(dirname "$config")" playwright.config.ts "end-to-end tests" "${projects[@]}"
done

ladder_step_end
