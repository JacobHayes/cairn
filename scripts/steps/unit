#!/usr/bin/env bash
# Step unit: unit tests for every Rust crate (the property, integration, and cost steps run
# the rest).
# PRACTICES, The validation ladder. One suite per crate, so a crate whose tests
# vanish fails the step. The library crates' integration tests are modules of one test binary
# (crates/tests/tests/integration, counted for their crates by scripts/ladder-tests; the
# binary's and the schema's keep their own), told apart by module path: property tests live in `mod
# property` (in `property_*.rs`), cost tests in `mod cost` (in `cost_*.rs`), the store
# conformance suite in `mod conformance` (in `conformance.rs`), the in-process tests of the
# API and the binary in `mod in_process`, and the binary's tests that need the web build
# embedded in `mod binary` (in its `binary.rs`, so `binary::binary::`); all are skipped here
# by name, and the property, integration, browser, and cost steps run them. Every step's tests run through scripts/ladder-tests,
# which runs the workspace's test binaries in parallel.
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_STEP=unit
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

ladder_require_tool cargo cargo --version
# The counts below are read from cargo's output, which must not carry color codes (CI sets
# CARGO_TERM_COLOR=always).
export CARGO_TERM_COLOR=never
ladder_require_tool node node --version

crates=$(cargo metadata --no-deps --format-version 1 --locked | node -e '
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
    for (const item of JSON.parse(text).packages) console.log(item.name);
  });')
# cairn-tests holds the library crates' integration tests, which count for those crates
# (scripts/ladder-tests); it is no suite of its own.
crates=$(grep -vx cairn-tests <<<"$crates")
# Every workspace crate is a suite, whatever test binaries it builds, unit and integration
# together, each test counted for the crate whose binary ran it. The doc tests are the integration step's:
# no crate has one, and the pass that looks for them costs seconds.
ladder_cargo_test -- "${ladder_unit_skips[@]}" || ladder_fail "cargo test reported failures"
while IFS= read -r crate; do
  [ -n "$crate" ] || continue
  ladder_suite "$crate tests" "$(ladder_tests_matching "$crate" "")" tests
done <<<"$crates"

ladder_step_end
