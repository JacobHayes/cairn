#!/usr/bin/env bash
# Step cost: cost tests at the schema limits, budgeted in operations, not wall-clock time
# (left out of check:fast).
# PRACTICES, The validation ladder. Cost tests are the tests in
# `tests/integration/cost_*.rs`, each inside `mod cost`: a pass over a graph at the schema's
# limits, which is structurally slow, so they run in the full check and not in check:fast
# (decisions/2026-10-09-cost-tests-run-in-the-full-check-only.md). Like the property tests
# they are modules of their crate's one integration test binary, selected by module path, one
# suite per file, counted from the test names (`<file>::cost::<test>`).
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_STEP=cost
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

ladder_require_tool cargo cargo --version
ladder_require_tool node node --version
# The counts below are read from cargo's output, which must not carry color codes (CI sets
# CARGO_TERM_COLOR=always).
export CARGO_TERM_COLOR=never

ladder_cargo_test --test integration -- cost:: || ladder_fail "cargo test reported failures"
ladder_file_suites cost

ladder_step_end
