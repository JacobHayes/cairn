#!/usr/bin/env bash
# The targeted inner loop in one command (`mise run test [FILTER...]`): the Rust tests and the
# web unit tests that match, and nothing else built or run.
#
# usage: scripts/test [FILTER...]
#   With filters: every Rust test whose name contains one of them (any crate, any rung's: unit,
#   property, conformance, ...), then, in each web package, the Vitest files whose path
#   contains one, or, where no file does, the tests whose name matches one.
#   Without: the tests for what the current change touches (scripts/changed): the fast Rust
#   tests (rung 2's) when it touches a Rust input, and the web unit tests when it touches a
#   web input.
# The Rust test binaries are built as the ladder builds them (scripts/ladder-tests: the
# workspace, every feature, no examples), so cargo recompiles only what the change made stale
# and the next `mise run check:fast` finds the binaries built. It fails when nothing matched.
# The binary's own tests that serve the web app (`binary::binary::`, rung 6's) need its build
# embedded: `mise run build:web` first.
set -euo pipefail
cd "$(dirname "$0")/.."
filters=("$@")
if [ ${#filters[@]} -gt 0 ]; then
  rust=1
  web=1
else
  read -r rust web count < <(scripts/changed)
  [ "$rust" = 1 ] || [ "$web" = 1 ] || { echo "test: $count files changed, none a Rust or web input: no tests to run"; exit 0; }
fi
ran=0

if [ "$rust" = 1 ]; then
  LADDER_RUNG="test"
  # shellcheck source=scripts/ladder-lib.sh
  source scripts/ladder-lib.sh
  arguments=("${ladder_unit_skips[@]}")
  [ ${#filters[@]} -eq 0 ] || arguments=("${filters[@]}")
  mkdir -p dist/ladder
  results=dist/ladder/test-results
  # Each binary's result line, except the ones where nothing matched; a failure prints its
  # whole output, and fails the run (pipefail).
  scripts/ladder-tests "$results" -- "${arguments[@]}" | { grep -v -E ': test result: ok\. 0 passed' || true; }
  rust_ran=$(grep -c . "$results" || true)
  echo "test: Rust: $rust_ran tests passed"
  ran=$((ran + rust_ran))
fi

if [ "$web" = 1 ]; then
  built=
  # A test's full name is its suites' titles and its own joined by " > ", as the reporter
  # prints it, but the titles sit apart in the source, so grep looks for the last one.
  names=$(IFS='|'; echo "${filters[*]}")
  needles=()
  for filter in "${filters[@]}"; do needles+=(-e "${filter##* > }"); done
  for config in web/*/vitest.config.ts; do
    package=$(dirname "$config")
    mapfile -t files < <(find "$package/src" \( -name '*.test.ts' -o -name '*.test.tsx' \) | sort)
    selection=()
    if [ ${#filters[@]} -eq 0 ]; then
      selection=("${files[@]}")
    else
      # The files whose path contains a filter; where none does, the files naming a test that
      # does (grep finds them, and Vitest's -t then runs only those tests). A cheap look first
      # keeps a Rust-only filter from paying for Vitest's start.
      patterns=()
      for filter in "${filters[@]}"; do patterns+=(-e "$filter"); done
      mapfile -t selection < <(printf '%s\n' "${files[@]}" | grep -F "${patterns[@]}" || true)
      if [ ${#selection[@]} -eq 0 ]; then
        mapfile -t selection < <(grep -lF "${needles[@]}" "${files[@]}" || true)
        [ ${#selection[@]} -eq 0 ] || selection+=(-t "$names")
      fi
    fi
    [ ${#selection[@]} -gt 0 ] || continue
    # The authoring tests check the editors against the browser host's module: cargo decides
    # whether it is stale, and the bindings are rebound only when it was.
    [ -n "$built" ] || { mise-tasks/build/wasm; built=yes; }
    report=$PWD/$package/dist/vitest.json
    mkdir -p "$package/dist"
    # Paths relative to the package, as Vitest filters its files.
    run=("${selection[@]#"$package"/}")
    (cd "$package" && "$OLDPWD/node_modules/.bin/vitest" run --reporter=default --reporter=json \
      --outputFile.json="$report" "${run[@]}") || { echo "test: web unit tests failed in $package" >&2; exit 1; }
    # Tests that ran: a name filter skips the rest of every file it opens.
    # shellcheck disable=SC2016 # the backticks are a JavaScript template literal
    total=$(node -e 'const report = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); console.log(report.numPassedTests);' "$report")
    [ "$total" -eq 0 ] || echo "test: $package: $total web unit tests passed"
    ran=$((ran + total))
  done
fi

[ "$ran" -gt 0 ] || { echo "test: nothing matched ${filters[*]}" >&2; exit 1; }
