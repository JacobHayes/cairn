        },
        {
          "required": [
            "reference"
          ]
        },
        {
          "required": [
            "message_draft"
          ]
        }
      ],
      "properties": {
        "example": {
          "$ref": "#/$defs/Url"
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttachmentKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "message_draft": {
          "$ref": "#/$defs/MessageTemplate"
        },
        "reference": {
          "$ref": "#/$defs/Url"
        },
        "template": {
          "$ref": "#/$defs/Url"
        },
        "tip": {
          "$ref": "#/$defs/Markdown"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/Title"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Role": {
      "additionalProperties": false,
      "description": "A role (A6): a named slot, single or multi valued, filled per journey with entities.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug",
          "description": "The id, unique in the graph."
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "The stable key: optional in a file."
        },
        "multi": {
          "description": "Filled by several entities rather than one.",
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/Title"
            },
            {
              "type": "null"
            }
          ],
          "description": "A label."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "RoleKey": {
      "description": "Starts with \"r_\"; at most id_bytes_max (64) bytes.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^r_[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "RouteId": {
      "description": "A route id: a slug, unique in the deployment.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "RouteKind": {
      "description": "What a route is for (PRD glossary, Route): fixed when it is created.",
      "oneOf": [
        {
          "const": "process",
          "description": "A process template: journeys start from it.",
          "type": "string"
        },
        {
          "const": "segment",
          "description": "A reusable piece of a process: it is only inserted, never started (A21).",
          "type": "string"
        }
      ]
    },
    "Slug": {
      "description": "An id: lowercase letters, digits, '_' and '-', at most id_bytes_max (64) bytes.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "Title": {
      "description": "Single-line text, at most title_bytes_max (256) bytes.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "Url": {
      "description": "A URL: scheme:rest, no whitespace, at most link_bytes_max (4 KiB) bytes.",
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "VersionNumber": {
      "minimum": 1,
      "type": "integer"
    },
    "Weight": {
      "maximum": 1000,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://github.com/JacobHayes/cairn/schema/route-file.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The file document (A13, A14; ARCHITECTURE, File format): a route version or draft as\nwritten, unresolved. Nodes refer to each other by path and to roles and kinds by id;\nkeys may be left out for import to match by path against the version extended, or mint.\nThe JSON Schema in `schema/` describes this type.",
  "properties": {
    "default_owner": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slug"
        },
        {
          "type": "null"
        }
      ],
      "description": "The role that owns nodes no ancestor gives an owner (A6)."
    },
    "description": {
      "anyOf": [
        {
          "$ref": "#/$defs/Markdown"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the route is for."
    },
    "extends": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionNumber"
        },
        {
          "type": "null"
        }
      ],
      "description": "The published version this one extends, or none for a new route."
    },
    "format": {
      "$ref": "#/$defs/FormatVersion",
      "description": "The file format version."
    },
    "kind": {
      "$ref": "#/$defs/RouteKind",
      "description": "Process or segment (A21); a file that leaves it out is a process."
    },
    "name": {
      "$ref": "#/$defs/Title",
      "description": "The route's name."
    },
    "nodes": {
      "description": "The nodes, each naming its parent by path.",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 2000,
      "type": "array"
    },
    "participation_kinds": {
      "description": "The participation kinds beyond `owner`.",
      "items": {
        "$ref": "#/$defs/ParticipationKind"
      },
      "maxItems": 32,
      "type": "array"
    },
    "roles": {
      "description": "The roles.",
      "items": {
        "$ref": "#/$defs/Role"
      },
      "maxItems": 32,
      "type": "array"
    },
    "route": {
      "$ref": "#/$defs/RouteId",
      "description": "The route's id."
    }
  },
  "required": [
    "format",
    "route",
    "name",
    "nodes"
  ],
  "title": "RouteFile",
  "type": "object"
}
