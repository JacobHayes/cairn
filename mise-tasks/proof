#!/usr/bin/env -S bash -euo pipefail
#MISE description="Take screenshots and video of a change: build the web app, then run the *.proof.ts specs in a directory outside the repository with web/app/playwright.proof.config.ts"
#MISE depends=["packages", "build:web"]
# usage: mise run proof <dir> [playwright test args...]
#   <dir>  the directory holding the *.proof.ts specs: absolute, or from the checkout's root
# AGENTS, Show a change people can see: nothing here is committed. The spec lives in the
# change's scratch directory, imports
# `test` from web/app/e2e/test.ts (by its absolute path; it starts a `cairn demo` for each test
# and points the page at it), with the browser tests' other helpers beside it, and saves its
# screenshots and video in the scratch directory.
cd "$(dirname "$0")/.."
repo=$PWD
dir=$(realpath -e "${1:?usage: mise run proof <dir> [playwright test args...]}")
shift
cd web/app
CAIRN_PROOF_DIR=$dir exec "$repo/node_modules/.bin/playwright" test -c playwright.proof.config.ts "$@"
