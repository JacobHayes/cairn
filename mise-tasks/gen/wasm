#!/usr/bin/env -S bash -euo pipefail
#MISE description="Regenerate web/wasm/generated/: the wasm-bindgen bindings of crates/wasm"
#MISE depends=["build:wasm"]
# ARCHITECTURE, Generated artifacts. Copies the JavaScript bindings and type declarations of
# the module build:wasm built into web/wasm/generated/, each with a header saying so; the
# .wasm itself stays in web/wasm/dist/bindgen/, a build output. Writes only into
# web/wasm/generated/.
from=web/wasm/dist/bindgen
to=web/wasm/generated
rm -rf "$to"
mkdir -p "$to"
for file in cairn_wasm.js cairn_wasm.d.ts cairn_wasm_bg.wasm.d.ts; do
  {
    echo "// Generated from crates/wasm by wasm-bindgen ('mise run gen'); do not edit."
    cat "$from/$file"
  } >"$to/$file"
done
