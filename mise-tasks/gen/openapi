#!/usr/bin/env -S bash -euo pipefail
#MISE description="Regenerate openapi/ from crates/api, and web/client/generated/ (the API types, and the engine's rule tables) from it"
#MISE depends=["packages"]
# ARCHITECTURE, Generated artifacts. Writes only into openapi/ and web/client/generated/;
# every file there is generated. The TypeScript types come from the OpenAPI document, so
# one generator writes both, in that order; the engine then writes rules.ts, the limits and
# transition tables the app reads. openapi-typescript is a devDependency of
# web/client, installed by the packages task.
generator=node_modules/.bin/openapi-typescript
rm -rf openapi web/client/generated
mkdir -p openapi web/client/generated
scripts/timed build cargo build --locked --quiet -p cairn-api --bin cairn-openapi --bin cairn-rules
cargo run --locked --quiet -p cairn-api --bin cairn-openapi -- openapi/cairn.json
"$generator" openapi/cairn.json -o web/client/generated/api.ts --silent
cargo run --locked --quiet -p cairn-api --bin cairn-rules -- web/client/generated/rules.ts
