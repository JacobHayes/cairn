#!/usr/bin/env -S bash -euo pipefail
#MISE description="Run the structural rules over every screen state at the widths where the layout can change (web/app/e2e/breakpoints.run.ts picks them), light, against cairn demo"
#MISE depends=["packages", "build:web"]
# usage: mise run sweep [playwright test args...]   (for example --grep "719px")
# Walks the table in web/app/e2e/screenshots.ts once per width (web/app/e2e/breakpoints.run.ts)
# and fails with every state and width that breaks a rule. Takes no pictures.
cd "$(dirname "$0")/.."
repo=$PWD
cd web/app
exec "$repo/node_modules/.bin/playwright" test --project=sweep "$@"
