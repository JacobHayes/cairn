#!/usr/bin/env -S bash -euo pipefail
#MISE description="Build the engine's module: crates/wasm for wasm32 in the CAIRN_WASM_PROFILE cargo profile (wasm-dev by default; wasm, optimized, for the release build and in CI), bound by wasm-bindgen into web/wasm/dist/bindgen/"
# ARCHITECTURE, Generated artifacts: the compiled .wasm is a build output, never checked in.
# This writes the module and its bindings to web/wasm/dist/bindgen/ (ignored); `mise run
# gen` copies the bindings (not the .wasm) into web/wasm/generated/, and the browser tests
# load the .wasm from here. The wasm-bindgen CLI pinned in mise.toml must be the version of
# the `wasm-bindgen` crate in Cargo.toml, or it refuses the module. Both profiles bind to the
# same generated files, so the generated step checks them from whichever profile built them: wasm-dev
# locally, wasm in CI (decisions/2026-10-08-the-check-builds-the-wasm-module-without-lto.md).
profile=${CAIRN_WASM_PROFILE:-wasm-dev}
case $profile in
  wasm | wasm-dev) ;;
  *)
    echo "build:wasm: CAIRN_WASM_PROFILE must be wasm or wasm-dev, not '$profile'" >&2
    exit 1
    ;;
esac
out=web/wasm/dist/bindgen
scripts/timed build cargo build --quiet --locked --profile "$profile" --target wasm32-unknown-unknown -p cairn-wasm --lib
target_dir=$(scripts/target-dir)
module=$target_dir/wasm32-unknown-unknown/$profile/cairn_wasm.wasm
# Cargo has just decided whether the module changed; bind it only if it did, so a run that
# changed nothing leaves the bindings (and their timestamps) alone. The bindings come from
# one profile or the other, so a switch rebinds too (the module is then the newer file).
if [ "$out/cairn_wasm_bg.wasm" -nt "$module" ] && [ "$(cat "$out/profile" 2>/dev/null)" = "$profile" ]; then
  exit 0
fi
rm -rf "$out"
mkdir -p "$out"
scripts/timed build wasm-bindgen --target web --out-dir "$out" --out-name cairn_wasm "$module"
# The shipped module is also shrunk by wasm-opt (-Oz): about 20% off its size and, with level
# "s", about 12 MB off a tab's memory. The features are the ones rustc's wasm32 target emits
# by default. The development build skips it: the pass takes seconds and nothing there
# measures size.
if [ "$profile" = wasm ]; then
  scripts/timed build wasm-opt -Oz --enable-bulk-memory --enable-sign-ext --enable-nontrapping-float-to-int --enable-mutable-globals \
    "$out/cairn_wasm_bg.wasm" -o "$out/cairn_wasm_bg.wasm"
fi
echo "$profile" >"$out/profile"
