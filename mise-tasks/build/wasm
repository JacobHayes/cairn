#!/usr/bin/env bash
#MISE description="Build the browser host's module: crates/wasm for wasm32 in the CAIRN_WASM_PROFILE cargo profile (wasm-dev by default; wasm, optimized, for the release build and in CI), bound by wasm-bindgen into web/wasm/dist/bindgen/"
# ARCHITECTURE, Generated artifacts: the compiled .wasm is a build output, never checked in.
# This writes the module and its bindings to web/wasm/dist/bindgen/ (ignored); `mise run
# gen` copies the bindings (not the .wasm) into web/wasm/generated/, and the browser tests
# load the .wasm from here. The wasm-bindgen CLI pinned in mise.toml must be the version of
# the `wasm-bindgen` crate in Cargo.toml, or it refuses the module. Both profiles bind to the
# same generated files, so rung 5 checks them from whichever profile built them: wasm-dev
# locally, wasm in CI (decisions/2026-10-08-the-check-builds-the-wasm-module-without-lto.md).
set -euo pipefail
cd "$(dirname "$0")/../.."
profile=${CAIRN_WASM_PROFILE:-wasm-dev}
case $profile in
  wasm | wasm-dev) ;;
  *)
    echo "build:wasm: CAIRN_WASM_PROFILE must be wasm or wasm-dev, not '$profile'" >&2
    exit 1
    ;;
esac
out=web/wasm/dist/bindgen
cargo build --quiet --locked --profile "$profile" --target wasm32-unknown-unknown -p cairn-wasm --lib
target_dir=$(cargo metadata --no-deps --format-version 1 --locked | node -e '
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => console.log(JSON.parse(text).target_directory));')
module=$target_dir/wasm32-unknown-unknown/$profile/cairn_wasm.wasm
# Cargo has just decided whether the module changed; bind it only if it did, so a run that
# changed nothing leaves the bindings (and their timestamps) alone. The bindings come from
# one profile or the other, so a switch rebinds too (the module is then the newer file).
if [ "$out/cairn_wasm_bg.wasm" -nt "$module" ] && [ "$(cat "$out/profile" 2>/dev/null)" = "$profile" ]; then
  exit 0
fi
rm -rf "$out"
mkdir -p "$out"
wasm-bindgen --target web --out-dir "$out" --out-name cairn_wasm "$module"
echo "$profile" >"$out/profile"
