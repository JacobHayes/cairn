#!/usr/bin/env bash
#MISE description="Build a release binary: the binary as build makes it, versioned by CAIRN_VERSION (a vX.Y.Z tag), copied to dist/release/cairn-<target> beside its SHA-256"
# ARCHITECTURE, Build, run, deploy: releases. CI's release jobs run this on each target.
set -euo pipefail
cd "$(dirname "$0")/../.."
[ -n "${CAIRN_VERSION:-}" ] || {
  echo "build:release: set CAIRN_VERSION to the release tag (vX.Y.Z)" >&2
  exit 1
}
version=${CAIRN_VERSION#v}
# build.rs refuses a CAIRN_VERSION that is not a semantic version.
mise run build
target_dir=$(cargo metadata --no-deps --format-version 1 --locked | node -e '
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => console.log(JSON.parse(text).target_directory));')
binary=$target_dir/release/cairn
# The binary must report the release's version: a build that kept an old one is not released.
reported=$("$binary" version)
[ "$reported" = "cairn $version" ] || {
  echo "build:release: the binary reports '$reported', not 'cairn $version'" >&2
  exit 1
}
triple=$(rustc -vV | sed -n 's/^host: //p')
# No version in the name, so releases/latest/download/cairn-<target> is a stable link; the
# version is in the binary and the tag. The checksum names the asset, so `sha256sum -c` works
# in the download directory.
name=cairn-$triple
rm -rf dist/release
mkdir -p dist/release
install -m 755 "$binary" "dist/release/$name"
(cd dist/release && sha256sum "$name" >"$name.sha256")
ls dist/release
