#!/usr/bin/env bash
#MISE description="Build the web app the binary embeds: the packages and the browser host's module (its dependencies), then the app's Vite build into web/app/dist/build/"
#MISE depends=["packages", "build:wasm"]
# ARCHITECTURE, Build, run, deploy: web assets and the wasm package are built before `cargo
# build` and embedded with rust-embed (crates/cairn/src/assets.rs). Build outputs, never
# checked in.
set -euo pipefail
cd "$(dirname "$0")/../.."
(cd web/app && ../../node_modules/.bin/vite build --config vite.config.ts)
[ -f web/app/dist/build/index.html ] || { echo "build:web: the build wrote no index.html" >&2; exit 1; }
