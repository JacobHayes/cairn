#!/usr/bin/env -S bash -euo pipefail
#MISE description="Build the release binary with the web build embedded: build:web with the optimized module (the wasm profile), then cargo build --release -p cairn"
CAIRN_WASM_PROFILE=wasm mise run build:web
cargo build --locked --release -p cairn
target_dir=$(scripts/target-dir)
echo "built $target_dir/release/cairn"
