#!/usr/bin/env bash
#MISE description="Build the static demo site: the packages and the browser host's module (its dependencies), then the app's Vite build on the in-browser host into web/app/dist/demo/"
#MISE depends=["packages", "build:wasm"]
# ARCHITECTURE, Web UI: in-browser host. The app with no server, seeded from the fixtures on
# every load, for a static host that answers every path with index.html. A build output,
# never checked in.
set -euo pipefail
cd "$(dirname "$0")/../.."
(cd web/app && ../../node_modules/.bin/vite build --config vite.config.ts --mode demo)
[ -f web/app/dist/demo/index.html ] || { echo "build:demo: the build wrote no index.html" >&2; exit 1; }
