#!/usr/bin/env -S bash -euo pipefail
#MISE description="Mutation-test the web app with StrykerJS (the whole app, or the files given): lists the mutants its unit tests leave alive in dist/mutation/web-survivors.tsv"
#MISE depends=["packages", "build:wasm"]
# usage: mise run mutants:web [file...]   (paths from the checkout's root, under web/app/src)
# The weekly mutation job runs it over the whole app (.github/workflows/mutants.yml). A survivor
# is a mutant no test notices: a missing assertion, or an equivalent mutant
# (decisions/2026-10-24-where-mutation-testing-runs.md). Stryker mutates a copy of the tree in
# web/app/dist/mutation/box (ignored), never the checkout's own files, so it is safe to run
# anywhere.
cd "$(dirname "$0")/../.."
repo=$PWD
args=()
if [ "$#" -gt 0 ]; then
  mutate=""
  for file in "$@"; do
    mutate+="${mutate:+,}${file#web/app/}"
  done
  args=(--mutate "$mutate")
fi
# Some tests read files outside the app by a path relative to themselves (the wasm module, the
# design tokens). The sandbox sits two directories deeper than the app (stryker.config.json:
# tempDirName, then its own sandbox-* directory), so those two directories are linked where
# the tests look.
rm -rf web/app/dist/mutation
mkdir -p web/app/dist/mutation/box/web/app
ln -s "$repo/web/wasm" web/app/dist/mutation/box/web/app/wasm
ln -s "$repo/design" web/app/dist/mutation/box/web/design
(cd web/app && nice "$repo/node_modules/.bin/stryker" run stryker.config.json ${args[@]+"${args[@]}"})
scripts/mutation-survivors stryker web/app/dist/mutation/stryker.json >web/app/dist/mutation/web-survivors.tsv
head -n 1 web/app/dist/mutation/web-survivors.tsv
