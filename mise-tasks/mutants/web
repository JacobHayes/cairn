#!/usr/bin/env -S bash -euo pipefail
#MISE description="Mutation-test the web app with StrykerJS (the whole app, one shard of it, or the files given): lists the mutants its unit tests leave alive in dist/mutation/web-survivors.tsv"
#MISE depends=["packages", "build:wasm"]
# usage: mise run mutants:web [--shard I/N] [file...]   (paths from the checkout's root, under web/app/src)
# The weekly mutation job runs it as N parallel shards that together cover the whole app
# (.github/workflows/mutants.yml); shard I of N (I from 1) takes every Nth file of the sorted
# list of mutated files, so the split is stable until files are added or removed. A survivor
# is a mutant no test notices: a missing assertion, or an equivalent mutant
# (decisions/2026-10-24-where-mutation-testing-runs.md). Stryker mutates a copy of the tree in
# web/app/dist/mutation/box (ignored), never the checkout's own files, so it is safe to run
# anywhere. Static mutants (top-level code that runs once) are left out in stryker.config.json:
# they were 9% of the mutants and 92% of the run time, each one running every test.
cd "$(dirname "$0")/../.."
repo=$PWD
args=()
shard=""
if [ "${1:-}" = "--shard" ]; then
  shard=$2
  shift 2
fi
if [ -n "$shard" ]; then
  index=${shard%/*}
  count=${shard#*/}
  [[ $index =~ ^[0-9]+$ && $count =~ ^[0-9]+$ ]] && [ "$index" -ge 1 ] && [ "$index" -le "$count" ] \
    || { echo "--shard wants I/N with 1 <= I <= N, got $shard" >&2; exit 2; }
  # The files stryker.config.json's mutate globs select, sorted, every Nth from the Ith.
  set -- $(node -e '
    const { globSync } = require("node:fs");
    const path = require("node:path");
    const [index, count] = process.argv.slice(1).map(Number);
    const globs = require("./web/app/stryker.config.json").mutate;
    process.chdir("web/app");
    const included = globs.filter((glob) => !glob.startsWith("!")).flatMap((glob) => globSync(glob));
    const excluded = globs.filter((glob) => glob.startsWith("!")).map((glob) => glob.slice(1));
    [...new Set(included)]
      .filter((file) => !excluded.some((glob) => path.matchesGlob(file, glob)))
      .sort()
      .filter((_, position) => position % count === index - 1)
      .forEach((file) => console.log("web/app/" + file));
  ' "$index" "$count")
fi
if [ "$#" -gt 0 ]; then
  mutate=""
  for file in "$@"; do
    mutate+="${mutate:+,}${file#web/app/}"
  done
  args=(--mutate "$mutate")
fi
# Some tests read files outside the app by a path relative to themselves (the wasm module, the
# design tokens). The sandbox sits two directories deeper than the app (stryker.config.json:
# tempDirName, then its own sandbox-* directory), so those two directories are linked where
# the tests look.
rm -rf web/app/dist/mutation
mkdir -p web/app/dist/mutation/box/web/app
ln -s "$repo/web/wasm" web/app/dist/mutation/box/web/app/wasm
ln -s "$repo/design" web/app/dist/mutation/box/web/design
# Vitest adds a GitHub annotation reporter when GITHUB_ACTIONS is set; every killed mutant
# fails tests, and the annotations and step summary they would fill overflow the job's limits.
# In CI the log gets a progress line as mutants finish, since the report is written only at the end.
reporters=clear-text,json
[ -z "${GITHUB_ACTIONS:-}" ] || reporters+=,progress-append-only
(cd web/app && env -u GITHUB_ACTIONS nice "$repo/node_modules/.bin/stryker" run stryker.config.json --reporters "$reporters" ${args[@]+"${args[@]}"})
scripts/mutation-survivors stryker web/app/dist/mutation/stryker.json >web/app/dist/mutation/web-survivors.tsv
head -n 1 web/app/dist/mutation/web-survivors.tsv
