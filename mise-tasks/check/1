#!/usr/bin/env bash
#MISE description="Rung 1: format, lint, typecheck (rustfmt, clippy, workspace lints, patina site labels, the wasm32 build of the runtime-free crates, the TypeScript typecheck, eslint, the CSS lint)"
# PRACTICES, The validation ladder, rung 1; Code conventions. Rung 1 runs tools, not tests:
# it fails if a tool is missing or reports nothing checked. The TypeScript typecheck and
# eslint joined with the first TypeScript package, web/client
# (decisions/2026-10-06-rung-1s-typescript-checks-join-with-the-first-typescript.md).
# Outside CI it first applies the fixes its tools can make themselves (formatting, the lint
# fixes that are machine-applicable) and only then checks, so what fails is what a person
# has to decide (decisions/2026-10-09-local-checks-fix-and-ci-verifies.md).
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_RUNG=1
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

# PRACTICES, Code conventions: lints denied only in some crates, raised on top of the
# workspace lints. A crate listed here need not exist yet; its lints apply from the change
# that adds it to the workspace.
declare -A scoped_lints=(
  [cairn-engine]="clippy::indexing_slicing clippy::disallowed_types missing_docs"
  [cairn-api]="clippy::panic"
  [cairn-mcp]="clippy::panic"
  [cairn-assistant]="clippy::panic"
)

ladder_require_tool cargo cargo --version
ladder_require_tool rustfmt cargo fmt --version
ladder_require_tool clippy cargo clippy --version
ladder_require_tool node node --version

# PRACTICES, Code conventions (TypeScript): the strict typecheck over every web package's
# sources and generated types, and eslint with the type-aware rules over the hand-written
# sources (generated code is not linted). Both come from the npm workspace: `npm ci`. They
# need nothing cargo builds, so they run in the background while the Rust checks below do,
# each writing its output and status under dist/ladder/, and are read at the end. eslint
# caches each file's result (dist/ladder/eslint-cache, which a changed config or eslint
# version discards): a file that did not change is not linted again, so a change to one file's
# types is not re-linted in its callers until they change; CI starts with no cache.
# Outside CI that one eslint run also fixes (`--fix`), and the typecheck starts once it is
# done, so it reads the fixed files.
for tool in tsc eslint; do
  [ -x "node_modules/.bin/$tool" ] || ladder_fail "tool missing: $tool (run npm ci)"
done
fixing=0
eslint_fix=()
if ladder_fixing; then
  fixing=1
  eslint_fix=(--fix)
  sums_before=$(ladder_source_sums)
fi
typescript=dist/ladder/rung-1
rm -rf "$typescript"
mkdir -p "$typescript"
{
  status=0
  node_modules/.bin/eslint "${eslint_fix[@]}" --max-warnings 0 --cache --cache-location dist/ladder/eslint-cache \
    --format json . >"$typescript/eslint.json" \
    2>"$typescript/eslint.err" || status=$?
  echo "$status" >"$typescript/eslint.status"
} &
eslint_job=$!
{
  if [ "$fixing" -eq 1 ]; then
    until [ -f "$typescript/eslint.status" ]; do sleep 0.1; done
  fi
  status=0
  node_modules/.bin/tsc -p tsconfig.json --listFiles >"$typescript/tsc.out" 2>&1 || status=$?
  echo "$status" >"$typescript/tsc.status"
} &

# Workspace members as "name<TAB>manifest path" lines.
# shellcheck disable=SC2016 # the backticks are a JavaScript template literal
members=$(cargo metadata --no-deps --format-version 1 --locked | node -e '
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
    for (const item of JSON.parse(text).packages) console.log(`${item.name}\t${item.manifest_path}`);
  });')

# Every crate inherits the workspace lints; one that opts out escapes all of them.
inheriting=0
while IFS=$'\t' read -r name manifest; do
  [ -n "$name" ] || continue
  # Comments and whitespace are dropped first, so any spelling Cargo accepts passes: the
  # [lints] table, the dotted key at top level, or an inline table.
  awk '{ line = $0; sub(/#.*/, "", line); gsub(/[ \t]/, "", line) }
       line ~ /^\[/ { table = line; next }
       table == "[lints]" && line == "workspace=true" { found = 1 }
       table == "" && (line == "lints.workspace=true" || line == "lints={workspace=true}") { found = 1 }
       END { exit !found }' "$manifest" \
    || ladder_fail "$name does not inherit the workspace lints ([lints] workspace = true in $manifest)"
  inheriting=$((inheriting + 1))
done <<<"$members"
ladder_suite "workspace lints inherited" "$inheriting" crates

# The scoped lints of the clippy run below, raised to warn (explained there).
raised=()
for name in "${!scoped_lints[@]}"; do
  for lint in ${scoped_lints[$name]}; do
    raised+=(-W "$lint")
  done
done
# Outside CI: format, then apply clippy's machine-applicable suggestions (the same targets,
# features, and raised lints as the clippy run below, which then checks the result), then
# format again, as a fix can leave code the formatter would lay out differently. A failure
# here is not reported: the checks below find it again and report it.
if [ "$fixing" -eq 1 ]; then
  cargo fmt --all >/dev/null 2>&1 || true
  cargo clippy --fix --allow-dirty --allow-staged --locked --workspace --no-deps --all-targets \
    --all-features -- "${raised[@]}" >"$typescript/clippy-fix.out" 2>&1 || true
  cargo fmt --all >/dev/null 2>&1 || true
  wait "$eslint_job" || true
  fixed=$(ladder_changed_files "$sums_before" "$(ladder_source_sums)")
  [ "$fixed" -eq 0 ] || ladder_show "$ladder_name: fixed $fixed files (commit them)"
fi

# rustfmt -v names each file it checks; a check failure prints the diff.
fmt_status=0
fmt_output=$(cargo fmt --all --check -- -v 2>&1) || fmt_status=$?
printf '%s\n' "$fmt_output"
[ "$fmt_status" -eq 0 ] || {
  { grep -v -e '^Formatting ' -e '^Spent ' <<<"$fmt_output" || true; } | ladder_show
  ladder_fail "rustfmt: files are not formatted (run: cargo fmt --all)"
}
ladder_suite rustfmt "$(grep -c '^Formatting ' <<<"$fmt_output" || true)" files

# clippy over the whole workspace in one run, warnings denied (pedantic included) and each
# crate's scoped lints on top. Cargo resolves features per invocation, so a run per scoped
# crate would check its own copy of the dependencies; one run checks them once. The scoped
# lints are raised to warn for every crate in that run, and a warning from one counts only in
# a crate that scopes it: any other warning or error fails the rung, as `-D warnings` did.
# `--no-deps` lints the workspace's crates and none of their dependencies.
scopes=$(for name in "${!scoped_lints[@]}"; do printf '%s\t%s\n' "$name" "${scoped_lints[$name]}"; done)
clippy_status=0
clippy_output=$(cargo clippy -q --locked --workspace --no-deps --all-targets --all-features \
  --message-format=json -- "${raised[@]}" 2>"$typescript/clippy-cargo.err") || clippy_status=$?
cat "$typescript/clippy-cargo.err"
# The diagnostics that fail the rung, rendered, then how many crates were checked; a crate's
# package id is "path+file:///<dir>#<name>@<version>", or "...<dir>#<version>" when the name
# is the directory's.
# shellcheck disable=SC2016 # the backticks are a JavaScript template literal
clippy_result=$(SCOPES="$scopes" node -e '
  const path = require("path");
  const nameOf = (id) => {
    const [location, fragment] = id.split("#");
    return fragment.includes("@") ? fragment.split("@")[0] : path.basename(location);
  };
  const scoped = new Map();
  for (const line of process.env.SCOPES.split("\n").filter(Boolean)) {
    const [name, lints] = line.split("\t");
    for (const lint of lints.split(" ")) scoped.set(lint, [...(scoped.get(lint) ?? []), name]);
  }
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
    const checked = new Set();
    const shown = new Set();
    let failures = 0;
    for (const line of text.split("\n")) {
      if (!line.startsWith("{")) continue;
      const message = JSON.parse(line);
      const crate = message.package_id ? nameOf(message.package_id) : null;
      if (message.reason === "compiler-artifact" && message.package_id.startsWith("path+file://")) checked.add(crate);
      if (message.reason !== "compiler-message") continue;
      const { level, code, rendered } = message.message;
      // The per-crate totals ("N warnings emitted") repeat what is counted here.
      if (code === null && /^\d+ warnings? emitted|^aborting due to/.test(message.message.message)) continue;
      if (level !== "warning" && level !== "error") continue;
      const owners = code === null ? undefined : scoped.get(code.code);
      if (level === "warning" && owners !== undefined && !owners.includes(crate)) continue;
      // The lib and its unit tests are checked as two targets and report the same diagnostic.
      const text = rendered ?? `${crate}: ${message.message.message}\n`;
      if (shown.has(text)) continue;
      shown.add(text);
      process.stderr.write(text);
      failures++;
    }
    console.log(`${failures} ${checked.size}`);
  });' <<<"$clippy_output" 2>"$typescript/clippy.err")
ladder_show <"$typescript/clippy.err"
read -r clippy_failures checked <<<"$clippy_result"
if [ "$clippy_status" -ne 0 ] || [ "$clippy_failures" -ne 0 ]; then
  # Cargo itself failed (a lock file out of date, say) when clippy named no diagnostic.
  [ "$clippy_failures" -ne 0 ] || ladder_show <"$typescript/clippy-cargo.err"
  ladder_fail "clippy reported errors or warnings"
fi
ladder_suite clippy "$checked" crates

# PRACTICES, Simulation with patina: every `sometimes!`, `reachable!`, `always!`, and
# `buggify!` site carries a literal kebab-case label. A campaign reads the labels declared
# anywhere in a binary, and one holding a space breaks every campaign over it (patina gap 5,
# decisions/2026-10-06-patina-a-site-label-holding-a-space-breaks-every-campaign.md). The
# exceptions: the one reproducer of that gap, and the durability testbed's crash oracles,
# whose kebab-case labels are constants so a campaign, which draws no crash, does not
# declare them (decisions/2026-10-07-patina-a-campaign-draws-no-crash-and-no-crash-leaves-part.md).
label_exceptions=(
  testbeds/multiplayer/gaps/src/bin/spaced_label.rs
  testbeds/durability/src/restart.rs
)
for exception in "${label_exceptions[@]}"; do
  [ -f "$exception" ] || ladder_fail "the label exception $exception no longer exists"
done
mapfile -t sources < <(find crates testbeds -name '*.rs' -not -path '*/target/*' | sort |
  grep -vxF -f <(printf '%s\n' "${label_exceptions[@]}"))
# shellcheck disable=SC2016 # the backticks are a JavaScript template literal
labels=$(node -e '
  const fs = require("fs");
  const site = /(?<![A-Za-z0-9_])(sometimes|reachable|always|buggify)!\s*\(/g;
  const kebab = /^[a-z0-9]+(-[a-z0-9]+)*$/;
  let count = 0;
  const bad = [];
  for (const file of process.argv.slice(1)) {
    const text = fs.readFileSync(file, "utf8");
    for (const match of text.matchAll(site)) {
      // The arguments up to the closing parenthesis, and the string literals among them.
      let depth = 0, at = match.index + match[0].length - 1, literal = null, literals = [];
      for (; at < text.length; at++) {
        const char = text[at];
        if (literal !== null) {
          if (char === "\\") { literal += text[++at]; continue; }
          if (char === "\"") { literals.push(literal); literal = null; } else literal += char;
          continue;
        }
        if (char === "\"") literal = "";
        else if (char === "(") depth++;
        else if (char === ")" && --depth === 0) break;
      }
      const line = text.slice(0, match.index).split("\n").length;
      const label = literals.at(-1);
      count++;
      if (label === undefined || !kebab.test(label)) bad.push(`${file}:${line}: ${match[1]}! label ${JSON.stringify(label ?? null)}`);
    }
  }
  for (const line of bad) console.error(line);
  console.log(bad.length === 0 ? count : -1);
' "${sources[@]}" 2>"$typescript/labels.err")
ladder_show <"$typescript/labels.err"
[ "$labels" -ge 0 ] || ladder_fail "a patina site label is not a kebab-case literal"
ladder_suite "patina site labels" "$labels" sites

# ARCHITECTURE, Repository layout: the service is runtime-free (no tokio, database driver,
# or transport), so it builds for the browser with the engine, schema, and store beneath it,
# and the browser host (crates/wasm) on top. A dependency that pulls in a runtime fails here.
wasm_crates=(cairn-service cairn-wasm)
wasm_packages=()
for name in "${wasm_crates[@]}"; do
  wasm_packages+=(-p "$name")
done
ladder_run "a runtime-free crate's build for wasm32-unknown-unknown" \
  cargo check -q --locked --target wasm32-unknown-unknown "${wasm_packages[@]}"
ladder_suite "wasm32-unknown-unknown build" "${#wasm_crates[@]}" crates

# The TypeScript checks started at the top. `--listFiles` names every file the typecheck read,
# after any errors.
wait
[ "$(cat "$typescript/tsc.status")" -eq 0 ] || {
  { grep -v "^/" "$typescript/tsc.out" || true; } | ladder_show
  ladder_fail "the TypeScript typecheck reported errors"
}
typed=$(grep -c "^$PWD/web/" "$typescript/tsc.out" || true)
ladder_suite "TypeScript typecheck" "$typed" files
[ "$(cat "$typescript/eslint.status")" -eq 0 ] || {
  ladder_show <"$typescript/eslint.err"
  { node_modules/.bin/eslint --max-warnings 0 . 2>&1 || true; } | ladder_show
  ladder_fail "eslint reported problems"
}
# shellcheck disable=SC2016 # the backticks are a JavaScript template literal
linted=$(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).length);' "$typescript/eslint.json")
ladder_suite eslint "$linted" files

# DESIGN, Layout (the frame): one scroller per region, and tokens for colour and radius, in the app's
# CSS (`mise run lint:css`; its rules are web/app/src/lint/css.ts). It prints the files it checked.
css_files=$(mise-tasks/lint/css 2>"$typescript/css.err") || {
  ladder_show <"$typescript/css.err"
  ladder_fail "the CSS lint reported violations"
}
ladder_suite "css lint" "$css_files" files

ladder_rung_end
