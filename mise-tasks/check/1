#!/usr/bin/env bash
#MISE description="Rung 1: format, lint, typecheck (rustfmt, clippy, workspace lints)"
# PRACTICES, The validation ladder, rung 1; Code conventions. Rung 1 runs tools, not tests:
# it fails if a tool is missing or reports nothing checked. The TypeScript typecheck and
# eslint join this rung with the first TypeScript package (DECISIONS.md).
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_RUNG=1
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

# PRACTICES, Code conventions: lints denied only in some crates, raised on top of the
# workspace lints. A crate listed here need not exist yet; its lints apply from the change
# that adds it to the workspace.
declare -A scoped_lints=(
  [cairn-engine]="-D clippy::indexing_slicing -D clippy::disallowed_types -D missing_docs"
  [cairn-api]="-D clippy::panic"
  [cairn-mcp]="-D clippy::panic"
)

ladder_require_tool cargo cargo --version
ladder_require_tool rustfmt cargo fmt --version
ladder_require_tool clippy cargo clippy --version
ladder_require_tool node node --version

# Workspace members as "name<TAB>manifest path" lines.
# shellcheck disable=SC2016 # the backticks are a JavaScript template literal
members=$(cargo metadata --no-deps --format-version 1 --locked | node -e '
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
    for (const item of JSON.parse(text).packages) console.log(`${item.name}\t${item.manifest_path}`);
  });')

# Every crate inherits the workspace lints; one that opts out escapes all of them.
inheriting=0
while IFS=$'\t' read -r name manifest; do
  [ -n "$name" ] || continue
  # Comments and whitespace are dropped first, so any spelling Cargo accepts passes: the
  # [lints] table, the dotted key at top level, or an inline table.
  awk '{ line = $0; sub(/#.*/, "", line); gsub(/[ \t]/, "", line) }
       line ~ /^\[/ { table = line; next }
       table == "[lints]" && line == "workspace=true" { found = 1 }
       table == "" && (line == "lints.workspace=true" || line == "lints={workspace=true}") { found = 1 }
       END { exit !found }' "$manifest" \
    || ladder_fail "$name does not inherit the workspace lints ([lints] workspace = true in $manifest)"
  inheriting=$((inheriting + 1))
done <<<"$members"
ladder_suite "workspace lints inherited" "$inheriting" crates

# rustfmt -v names each file it checks; a check failure prints the diff.
fmt_status=0
fmt_output=$(cargo fmt --all --check -- -v 2>&1) || fmt_status=$?
grep -v -e '^Formatting ' -e '^Spent ' <<<"$fmt_output" || true
[ "$fmt_status" -eq 0 ] || ladder_fail "rustfmt: files are not formatted (run: cargo fmt --all)"
ladder_suite rustfmt "$(grep -c '^Formatting ' <<<"$fmt_output" || true)" files

# clippy, warnings denied (pedantic included): once for the crates with no scoped lints,
# once per scoped crate. JSON on stdout names each crate checked; diagnostics go to stderr.
scoped=()
general=()
while IFS=$'\t' read -r name _; do
  if [ -n "${scoped_lints[$name]:-}" ]; then
    scoped+=("$name")
  else
    general+=(-p "$name")
  fi
done <<<"$members"
artifacts=""
run_clippy() {
  local output
  output=$(cargo clippy --locked --all-targets --all-features \
    --message-format=json-render-diagnostics "$@") || ladder_fail "clippy reported errors"
  artifacts+=$'\n'"$output"
}
if [ ${#general[@]} -gt 0 ]; then
  run_clippy "${general[@]}" -- -D warnings
fi
for name in "${scoped[@]}"; do
  # shellcheck disable=SC2086 # the scoped lints are separate words
  run_clippy -p "$name" -- -D warnings ${scoped_lints[$name]}
done
checked=$(grep '"reason":"compiler-artifact"' <<<"$artifacts" \
  | grep -o '"package_id":"path+file://[^"]*"' | sort -u | wc -l)
ladder_suite clippy "$checked" crates

ladder_rung_end
