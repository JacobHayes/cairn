#!/usr/bin/env bash
#MISE description="Rung 1: format, lint, typecheck (rustfmt, clippy, workspace lints, patina site labels, the wasm32 build of the runtime-free crates, the TypeScript typecheck, eslint)"
# PRACTICES, The validation ladder, rung 1; Code conventions. Rung 1 runs tools, not tests:
# it fails if a tool is missing or reports nothing checked. The TypeScript typecheck and
# eslint joined with the first TypeScript package, web/client (DECISIONS.md, 1.1).
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_RUNG=1
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

# PRACTICES, Code conventions: lints denied only in some crates, raised on top of the
# workspace lints. A crate listed here need not exist yet; its lints apply from the change
# that adds it to the workspace.
declare -A scoped_lints=(
  [cairn-engine]="-D clippy::indexing_slicing -D clippy::disallowed_types -D missing_docs"
  [cairn-api]="-D clippy::panic"
  [cairn-mcp]="-D clippy::panic"
  [cairn-assistant]="-D clippy::panic"
)

ladder_require_tool cargo cargo --version
ladder_require_tool rustfmt cargo fmt --version
ladder_require_tool clippy cargo clippy --version
ladder_require_tool node node --version

# Workspace members as "name<TAB>manifest path" lines.
# shellcheck disable=SC2016 # the backticks are a JavaScript template literal
members=$(cargo metadata --no-deps --format-version 1 --locked | node -e '
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
    for (const item of JSON.parse(text).packages) console.log(`${item.name}\t${item.manifest_path}`);
  });')

# Every crate inherits the workspace lints; one that opts out escapes all of them.
inheriting=0
while IFS=$'\t' read -r name manifest; do
  [ -n "$name" ] || continue
  # Comments and whitespace are dropped first, so any spelling Cargo accepts passes: the
  # [lints] table, the dotted key at top level, or an inline table.
  awk '{ line = $0; sub(/#.*/, "", line); gsub(/[ \t]/, "", line) }
       line ~ /^\[/ { table = line; next }
       table == "[lints]" && line == "workspace=true" { found = 1 }
       table == "" && (line == "lints.workspace=true" || line == "lints={workspace=true}") { found = 1 }
       END { exit !found }' "$manifest" \
    || ladder_fail "$name does not inherit the workspace lints ([lints] workspace = true in $manifest)"
  inheriting=$((inheriting + 1))
done <<<"$members"
ladder_suite "workspace lints inherited" "$inheriting" crates

# rustfmt -v names each file it checks; a check failure prints the diff.
fmt_status=0
fmt_output=$(cargo fmt --all --check -- -v 2>&1) || fmt_status=$?
grep -v -e '^Formatting ' -e '^Spent ' <<<"$fmt_output" || true
[ "$fmt_status" -eq 0 ] || ladder_fail "rustfmt: files are not formatted (run: cargo fmt --all)"
ladder_suite rustfmt "$(grep -c '^Formatting ' <<<"$fmt_output" || true)" files

# clippy, warnings denied (pedantic included): once for the crates with no scoped lints,
# once per scoped crate. `--no-deps` keeps a scoped crate's lints off the workspace crates it
# depends on (the engine's on the schema crate). JSON on stdout names each crate checked;
# diagnostics go to stderr.
scoped=()
general=()
while IFS=$'\t' read -r name _; do
  if [ -n "${scoped_lints[$name]:-}" ]; then
    scoped+=("$name")
  else
    general+=(-p "$name")
  fi
done <<<"$members"
artifacts=""
run_clippy() {
  local output
  output=$(cargo clippy --locked --no-deps --all-targets --all-features \
    --message-format=json-render-diagnostics "$@") || ladder_fail "clippy reported errors"
  artifacts+=$'\n'"$output"
}
if [ ${#general[@]} -gt 0 ]; then
  run_clippy "${general[@]}" -- -D warnings
fi
for name in "${scoped[@]}"; do
  # shellcheck disable=SC2086 # the scoped lints are separate words
  run_clippy -p "$name" -- -D warnings ${scoped_lints[$name]}
done
checked=$(grep '"reason":"compiler-artifact"' <<<"$artifacts" \
  | grep -o '"package_id":"path+file://[^"]*"' | sort -u | wc -l)
ladder_suite clippy "$checked" crates

# PRACTICES, Simulation with patina: every `sometimes!`, `reachable!`, `always!`, and
# `buggify!` site carries a literal kebab-case label. A campaign reads the labels declared
# anywhere in a binary, and one holding a space breaks every campaign over it (DECISIONS.md,
# 6.1, patina gap 5). The one reproducer of that gap is the exception.
label_exceptions=(testbeds/multiplayer/gaps/src/bin/spaced_label.rs)
for exception in "${label_exceptions[@]}"; do
  [ -f "$exception" ] || ladder_fail "the label exception $exception no longer exists"
done
mapfile -t sources < <(find crates testbeds -name '*.rs' -not -path '*/target/*' | sort |
  grep -vxF -f <(printf '%s\n' "${label_exceptions[@]}"))
# shellcheck disable=SC2016 # the backticks are a JavaScript template literal
labels=$(node -e '
  const fs = require("fs");
  const site = /(?<![A-Za-z0-9_])(sometimes|reachable|always|buggify)!\s*\(/g;
  const kebab = /^[a-z0-9]+(-[a-z0-9]+)*$/;
  let count = 0;
  const bad = [];
  for (const file of process.argv.slice(1)) {
    const text = fs.readFileSync(file, "utf8");
    for (const match of text.matchAll(site)) {
      // The arguments up to the closing parenthesis, and the string literals among them.
      let depth = 0, at = match.index + match[0].length - 1, literal = null, literals = [];
      for (; at < text.length; at++) {
        const char = text[at];
        if (literal !== null) {
          if (char === "\\") { literal += text[++at]; continue; }
          if (char === "\"") { literals.push(literal); literal = null; } else literal += char;
          continue;
        }
        if (char === "\"") literal = "";
        else if (char === "(") depth++;
        else if (char === ")" && --depth === 0) break;
      }
      const line = text.slice(0, match.index).split("\n").length;
      const label = literals.at(-1);
      count++;
      if (label === undefined || !kebab.test(label)) bad.push(`${file}:${line}: ${match[1]}! label ${JSON.stringify(label ?? null)}`);
    }
  }
  for (const line of bad) console.error(line);
  console.log(bad.length === 0 ? count : -1);
' "${sources[@]}")
[ "$labels" -ge 0 ] || ladder_fail "a patina site label is not a kebab-case literal (above)"
ladder_suite "patina site labels" "$labels" sites

# ARCHITECTURE, Repository layout: the service is runtime-free (no tokio, database driver,
# or transport), so it builds for the browser with the engine, schema, and store beneath it,
# and the browser host (crates/wasm) on top. A dependency that pulls in a runtime fails here.
wasm_crates=(cairn-service cairn-wasm)
wasm_packages=()
for name in "${wasm_crates[@]}"; do
  wasm_packages+=(-p "$name")
done
cargo check --locked --target wasm32-unknown-unknown "${wasm_packages[@]}" \
  || ladder_fail "a runtime-free crate does not build for wasm32-unknown-unknown"
ladder_suite "wasm32-unknown-unknown build" "${#wasm_crates[@]}" crates

# PRACTICES, Code conventions (TypeScript): the strict typecheck over every web package's
# sources and generated types, and eslint with the type-aware rules over the hand-written
# sources (generated code is not linted). Both come from the npm workspace: `npm ci`.
for tool in tsc eslint; do
  [ -x "node_modules/.bin/$tool" ] || ladder_fail "tool missing: $tool (run npm ci)"
done
node_modules/.bin/tsc -p tsconfig.json || ladder_fail "the TypeScript typecheck reported errors"
typed=$(node_modules/.bin/tsc -p tsconfig.json --listFilesOnly | grep -c "^$PWD/web/" || true)
ladder_suite "TypeScript typecheck" "$typed" files
linted_json=$(node_modules/.bin/eslint --max-warnings 0 --format json .) || {
  node_modules/.bin/eslint --max-warnings 0 . || true
  ladder_fail "eslint reported problems"
}
# shellcheck disable=SC2016 # the backticks are a JavaScript template literal
linted=$(node -e 'let text = ""; process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => console.log(JSON.parse(text).length));' <<<"$linted_json")
ladder_suite eslint "$linted" files

ladder_rung_end
