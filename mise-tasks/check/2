#!/usr/bin/env bash
#MISE description="Rung 2: unit tests for every Rust crate (property and cost tests: rung 3; store conformance and in-process API tests: rung 4)"
# PRACTICES, The validation ladder, rung 2. One suite per crate, so a crate whose tests
# vanish fails the rung. A crate's integration tests are modules of its one test binary,
# tests/integration/main.rs, told apart by module path: property tests live in `mod
# property` (in `property_*.rs`), cost tests in `mod cost` (in `cost_*.rs`), the store
# conformance suite in `mod conformance` (in `conformance.rs`), the in-process tests of the
# API and the binary in `mod in_process`, and the binary's tests that need the web build
# embedded in `mod binary` (in its `binary.rs`, so `binary::binary::`); all are skipped here
# by name, and rungs 3, 4, and 6 run them.
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_RUNG=2
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

ladder_require_tool cargo cargo --version
# The counts below are read from cargo's output, which must not carry color codes (CI sets
# CARGO_TERM_COLOR=always).
export CARGO_TERM_COLOR=never
ladder_require_tool node node --version

crates=$(cargo metadata --no-deps --format-version 1 --locked | node -e '
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
    for (const item of JSON.parse(text).packages) console.log(item.name);
  });')
skips=(--skip property:: --skip conformance:: --skip cost:: --skip in_process:: --skip binary::binary::)
# Every workspace crate is a suite, whatever test binaries it builds: unit, integration, and
# doc tests together, each test counted for the crate whose binary ran it. `--tests` builds
# only the targets that hold tests: a plain `cargo test` also links every example, which
# rung 1's clippy already compiles. Doc tests are a second run.
ladder_cargo_test --tests -- "${skips[@]}" || ladder_fail "cargo test reported failures"
tests=$ladder_tests
ladder_cargo_test --doc -- "${skips[@]}" || ladder_fail "the doc tests reported failures"
tests+=$'\n'"$ladder_tests"
ladder_tests=$tests
while IFS= read -r crate; do
  [ -n "$crate" ] || continue
  ladder_suite "$crate tests" "$(ladder_tests_matching "$crate" "")" tests
done <<<"$crates"

ladder_rung_end
