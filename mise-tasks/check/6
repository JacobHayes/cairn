#!/usr/bin/env bash
#MISE description="Rung 6: web unit tests (Vitest, one suite per web package with a vitest.config.ts), the binary with its web build embedded, and in-browser end-to-end against the wasm host and the binary (Playwright in Chromium, one suite per web package with a playwright.config.ts)"
# PRACTICES, The validation ladder, rung 6. The browser host's tests (brief 4.5) need the
# module (mise run build:wasm) and the server's answers to compare with (the cairn-wasm-cases
# binary, which walks the fixtures through the service natively); both are build outputs
# under web/wasm/dist/. The app's tests (brief 4.6) need the module and the fixture server.
# The binary (brief 4.7) embeds the app's build (web/app/dist/build/): its own tests that start
# it (`mod binary` in crates/cairn/tests/integration/binary.rs, so `binary::binary::`) are a
# suite here, and the app's server-host suite runs against it too (the `binary` project of
# web/app/playwright.config.ts).
# The module is built first: web unit tests (Vitest, from 4.6) run next, one suite per web
# package with a vitest.config.ts, and the authoring tests (5.6) check the editors against
# the module's engine; then each web package with a playwright.config.ts is a suite. A suite
# that runs no test, or any test that fails or is skipped, fails the rung. The browsers are
# Playwright's own, pinned with @playwright/test: `npx playwright install chromium` once per
# machine.
set -euo pipefail
cd "$(dirname "$0")/../.."
LADDER_RUNG=6
# shellcheck source=scripts/ladder-lib.sh
source scripts/ladder-lib.sh

ladder_require_tool cargo cargo --version
ladder_require_tool node node --version
ladder_require_tool wasm-bindgen wasm-bindgen --version
ladder_require_tool playwright node_modules/.bin/playwright --version
ladder_require_tool vitest node_modules/.bin/vitest --version
export CARGO_TERM_COLOR=never

mise run build:wasm || ladder_fail "the browser host's module did not build"

for config in web/*/vitest.config.ts; do
  package=$(dirname "$config")
  report="$PWD/$package/dist/vitest.json"
  mkdir -p "$package/dist"
  rm -f "$report"
  status=0
  (cd "$package" && "$OLDPWD/node_modules/.bin/vitest" run --reporter=default --reporter=json \
    --outputFile.json="$report") || status=$?
  [ -f "$report" ] || ladder_fail "Vitest wrote no report for $package"
  # shellcheck disable=SC2016 # the backticks are a JavaScript template literal
  read -r passed failed skipped < <(node -e '
    const report = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    console.log(`${report.numPassedTests} ${report.numFailedTests} ${report.numPendingTests + report.numTodoTests}`);' "$report")
  [ "$status" -eq 0 ] && [ "$failed" -eq 0 ] || ladder_fail "$failed web unit tests failed in $package"
  [ "$skipped" -eq 0 ] || ladder_fail "$skipped web unit tests were skipped in $package"
  ladder_suite "web unit: $package" "$passed" tests
done

# The web build the binary embeds, then the programs the browser tests start, built as the
# tests are (scripts/built): the binary, the example that seeds its database, and the fixture
# server the app's server-host tests (web/app, 4.6) run against. Built here so Playwright's
# start of them is a run, not a build.
(cd web/app && "$OLDPWD/node_modules/.bin/vite" build --config vite.config.ts) \
  || ladder_fail "the app's web build failed"
[ -f web/app/dist/build/index.html ] || ladder_fail "the app's web build wrote no index.html"
scripts/built || ladder_fail "the binary, the fixture server, or the seeding example did not build"
# The server's answers the browser host's tests compare with: cairn-wasm-cases, just built in
# the debug profile with the rest, walks the fixtures through the service. Unoptimized that
# takes tens of seconds, so it runs beside the binary's and the app's tests, which do not read
# its output, and only web/wasm's suite waits for it.
scripts/built cairn-wasm-cases web/wasm/dist/cases &
cases=$!
trap 'kill "$cases" 2>/dev/null || true' EXIT

ladder_cargo_test --test integration -- binary::binary:: || ladder_fail "the binary's tests failed"
ladder_suite "binary" "$(ladder_tests_matching cairn '^binary::binary::')" tests

for config in web/*/playwright.config.ts; do
  package=$(dirname "$config")
  report="$PWD/$package/dist/playwright.json"
  if [ "$package" = web/wasm ]; then
    wait "$cases" || ladder_fail "the server's agreement cases were not written"
  fi
  status=0
  (cd "$package" && PLAYWRIGHT_JSON_OUTPUT_NAME="$report" \
    "$OLDPWD/node_modules/.bin/playwright" test --reporter=list,json) || status=$?
  [ -f "$report" ] || ladder_fail "Playwright wrote no report for $package"
  # shellcheck disable=SC2016 # the backticks are a JavaScript template literal
  read -r passed failed skipped < <(node -e '
    const stats = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).stats;
    console.log(`${stats.expected} ${stats.unexpected + stats.flaky} ${stats.skipped}`);' "$report")
  [ "$status" -eq 0 ] && [ "$failed" -eq 0 ] || ladder_fail "$failed in-browser tests failed in $package"
  [ "$skipped" -eq 0 ] || ladder_fail "$skipped in-browser tests were skipped in $package"
  ladder_suite "in-browser end-to-end: $package" "$passed" tests
done

ladder_rung_end
