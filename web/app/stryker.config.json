{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.ts" },
  "concurrency": 4,
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "tempDirName": "dist/mutation/box/web/app",
  "mutate": ["src/**/*.ts", "src/**/*.tsx", "!src/**/*.test.ts", "!src/**/*.test.tsx", "!src/**/*.test-support.ts", "!src/**/*.d.ts"],
  "mutator": { "excludedMutations": ["StringLiteral", "OptionalChaining"] },
  "ignorePatterns": ["dist/mutation", "node_modules"],
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "dist/mutation/stryker.json" },
  "clearTextReporter": { "allowColor": false, "reportTests": false, "reportMutants": false, "reportScoreTable": true }
}
